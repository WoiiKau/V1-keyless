    local configBaseFolder = ConfigRoot

    local configSettingsFolder = ConfigRoot .. "/settings"

    local autoloadFile = ConfigRoot .. "/autoload.txt"

    local currentProfileName = "default"

    local isLoadingConfig = false



    local function getAutoloadInfo()

        if isfile and isfile(autoloadFile) then

            local text = readfile(autoloadFile)

            local name, en = text:match("([^|]+)|([^|]+)")

            return name or "default", (en == "true")

        end

        return "default", false

    end



    local function setAutoloadInfo(name, enabled)

        pcall(function()

            if not isfolder("NexHub") then makefolder("NexHub") end

            if not isfolder(configBaseFolder) then makefolder(configBaseFolder) end

            writefile(autoloadFile, tostring(name) .. "|" .. tostring(enabled))

        end)

    end



    local function saveConfig(profileName)

        if isLoadingConfig then return true end

        profileName = profileName or currentProfileName or "default"

        local success, err = pcall(function()

            if not isfolder("NexHub") then makefolder("NexHub") end

            if not isfolder(configBaseFolder) then makefolder(configBaseFolder) end

            if not isfolder(configSettingsFolder) then makefolder(configSettingsFolder) end



            local data = {}

            for k, v in pairs(NexUI.Config) do

                if type(v) ~= "function" then

                    data[k] = v

                end

            end

            local json = HttpService:JSONEncode(data)

            writefile(configSettingsFolder .. "/" .. profileName .. ".json", json)

            currentProfileName = profileName

        end)

        return success, err

    end



    local function loadConfig(profileName)

        isLoadingConfig = true

        profileName = profileName or currentProfileName or "default"

        local success, err = pcall(function()

            local filePath = configSettingsFolder .. "/" .. profileName .. ".json"

            if isfile and isfile(filePath) then

                local json = readfile(filePath)

                local data = HttpService:JSONDecode(json)

                if data and type(data) == "table" then

                    for flag, val in pairs(data) do

                        NexUI.Config[flag] = val

                        if NexUI.FlagUpdaters[flag] then

                            pcall(NexUI.FlagUpdaters[flag], val)

                        end

                        if NexUI.FlagCallbacks[flag] then

                            pcall(NexUI.FlagCallbacks[flag], val)

                        end

                    end

                end

            end

            currentProfileName = profileName

        end)

        task.delay(0.2, function() isLoadingConfig = false end)

        return success, err

    end



