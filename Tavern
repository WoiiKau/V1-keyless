-- Route transitions cleanly along the Mine entrance ramp when entering or exiting underground (-60 Y)
local resolveMineRouteTarget
do
local MINE_SURFACE_PORTAL = Vector3.new(420, 2.5, -93)
local MINE_RAMP_MID = Vector3.new(420, -29.5, -205)
local MINE_CAVERN_ENTRY = Vector3.new(420, -58.5, -315)

resolveMineRouteTarget = function(curPos, destPos)
    if not curPos or not destPos then return destPos end
    local curInTunnel = curPos.Y < -1.5 and math.abs(curPos.X - 420) < 95 and curPos.Z < -98
    local destInMine = destPos.Y < -20

    if destInMine then
        if curPos.Z > -96 and horizontalDist(curPos, MINE_SURFACE_PORTAL) > 9 then
            return MINE_SURFACE_PORTAL, false
        elseif curPos.Z > -195 then
            return MINE_RAMP_MID, false
        elseif curPos.Z > -305 and curPos.Y > -52 then
            return MINE_CAVERN_ENTRY, false
        end
    elseif curInTunnel then
        if curPos.Z < -325 or (curPos.Z < -310 and horizontalDist(curPos, MINE_CAVERN_ENTRY) > 10) then
            return MINE_CAVERN_ENTRY, false
        elseif curPos.Z < -215 then
            return MINE_RAMP_MID, false
        elseif curPos.Z < -98 or curPos.Y < -1.5 then
            return MINE_SURFACE_PORTAL, false
        end
    end

    return destPos, true
end
end

local function createComputedWaypoints(fromPos, destPos, agentRadius, canJump)
    local wps = {}
    local ok = pcall(function()
        local path = PathfindingService:CreatePath({
            AgentRadius = agentRadius or 1.5,
            AgentHeight = 5,
            AgentCanJump = canJump == true,
            AgentCanClimb = false,
        })
        path:ComputeAsync(fromPos, destPos)
        if path.Status == Enum.PathStatus.Success then
            wps = path:GetWaypoints()
        end
    end)
    return (ok and type(wps) == "table") and wps or {}
end

local function stopAutoWalk(hum, hrp)
    ActivePath.walking = false
    ActivePath.forceWalk = false
    ActivePath.canJump = false
    ActivePath.key = ""
    ActivePath.dest = nil
    ActivePath.targetPos = nil
    ActivePath.waypoints = {}
    ActivePath.lastProgressPos = nil
    ActivePath.lastProgressAt = 0
    ActivePath.stallCount = 0
    if hum and hrp then
        hum:MoveTo(hrp.Position)
    end
end

local function stepAutoWalk(now)
    if not ActivePath.walking then return end
    if not ActivePath.forceWalk and State.MoveMode ~= "Auto Walk" then return end
    local hrp, hum = getPlayerRoot()
    if not hrp or not hum then return end

    if not ActivePath.lastProgressPos or horizontalDist(hrp.Position, ActivePath.lastProgressPos) >= 0.6 then
        ActivePath.lastProgressPos = hrp.Position
        ActivePath.lastProgressAt = now
        ActivePath.stallCount = 0
    elseif (now - ActivePath.lastProgressAt) >= 0.85 then
        ActivePath.lastProgressAt = now
        ActivePath.computedAt = 0
        ActivePath.stallCount = (ActivePath.stallCount or 0) + 1
        if ActivePath.forceWalk then
            ActivePath.canJump = true
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum.Jump = true
            end
        else
            if ActivePath.stallCount >= 3 and ActivePath.key ~= "" then
                Cooldowns.walkFail[ActivePath.key] = now + 7.0
                stopAutoWalk(hum, hrp)
                return
            end
            -- Inside packed tavern layouts, activate prop pass-through and reprobe aisle instead of jumping onto chairs/tables
            Cooldowns.propBypassUntil = math.max(Cooldowns.propBypassUntil, now + 2.6)
            ActivePath.targetPos = nil
            if hrp.Position.Y > 4.8 and hum.FloorMaterial ~= Enum.Material.Air then
                hum.Jump = true
            end
        end
    end

    local wps = ActivePath.waypoints
    if #wps > 0 and ActivePath.idx <= #wps then
        local wpTol = (ActivePath.idx < #wps) and (ActivePath.forceWalk and 2.6 or 1.75) or 2.2
        while ActivePath.idx < #wps
            and horizontalDist(hrp.Position, wps[ActivePath.idx].Position) <= wpTol
            and math.abs(wps[ActivePath.idx].Position.Y - hrp.Position.Y) <= 7.0 do
            ActivePath.idx = ActivePath.idx + 1
        end
        local activeWp = wps[ActivePath.idx]
        if ActivePath.canJump and activeWp and activeWp.Action == Enum.PathWaypointAction.Jump and hum.FloorMaterial ~= Enum.Material.Air then
            hum.Jump = true
        end
        if now >= Cooldowns.lastWalkAt then
            Cooldowns.lastWalkAt = now + 0.14
            hum:MoveTo((activeWp and activeWp.Position) or ActivePath.dest)
        end
    elseif ActivePath.dest and now >= Cooldowns.lastWalkAt then
        Cooldowns.lastWalkAt = now + 0.25
        hum:MoveTo(ActivePath.dest)
    end
end

local function computeWalkPath(key, fromPos, destPos, now, canJump, targetPos)
    if ActivePath.computing then return end
    ActivePath.computing = true
    ActivePath.key = key
    ActivePath.dest = destPos
    if targetPos then
        ActivePath.targetPos = targetPos
    end
    ActivePath.computedAt = now
    if ActivePath.lastProgressAt == 0 then
        ActivePath.lastProgressPos = fromPos
        ActivePath.lastProgressAt = now
    end

    task.spawn(function()
        local radius = canJump and 1.2 or 0.85
        local wps = createComputedWaypoints(fromPos, destPos, radius, canJump)
        if #wps == 0 then
            wps = createComputedWaypoints(fromPos, destPos, canJump and 0.85 or 0.65, canJump)
        end
        if not canJump and math.abs(fromPos.Y - destPos.Y) <= 3.5 then
            local floorSurfaceY = math.max(fromPos.Y, destPos.Y) - 3.0
            local blockedOrClimbing = (#wps == 0)
            if not blockedOrClimbing then
                for i = 1, #wps do
                    if (wps[i].Position.Y - floorSurfaceY) >= 2.2 then
                        blockedOrClimbing = true
                        break
                    end
                end
            end
            if blockedOrClimbing then
                Cooldowns.propBypassUntil = math.max(Cooldowns.propBypassUntil, os.clock() + 2.5)
            end
        end
        if ActivePath.key == key then
            ActivePath.waypoints = wps
            ActivePath.idx = (#ActivePath.waypoints >= 2) and 2 or 1
        end
        ActivePath.computing = false
    end)
end

local function ensureWithinRange(key, targetPos, standPos, now, maxReach, allowWalkOverride)
    if not targetPos then return true end
    local hrp, hum = getPlayerRoot()
    if not hrp then return false end

    local isTavernTarget = (allowWalkOverride == nil)
    local myPlot = isTavernTarget and findPlotForOwner(LocalPlayer.UserId) or nil
    local wallBlocked = myPlot and isWallBlockedBetween(myPlot, hrp.Position, targetPos) or false

    if isWithinReach(hrp.Position, targetPos, maxReach) and not wallBlocked then
        if ActivePath.walking or hrp.AssemblyLinearVelocity.Magnitude > 3.0 then
            stopAutoWalk(hum, hrp)
            Cooldowns.moveArriveAt = now + 0.16
            return false
        end
        if now < Cooldowns.moveArriveAt then
            return false
        end
        return true
    end

    if allowWalkOverride ~= nil then
        if not allowWalkOverride then
            return false
        end
    elseif State.MoveMode == "Nearby Only" then
        return false
    end

    local rawDest = standPos or targetPos
    if isTavernTarget and myPlot then
        local needFreshDest = (State.MoveMode == "Auto Teleport")
            or ActivePath.key ~= key
            or not ActivePath.dest
            or ActivePath.computedAt == 0
            or not ActivePath.targetPos
            or (ActivePath.targetPos - targetPos).Magnitude > 2.5
        if needFreshDest then
            local hintDelta = standPos and Vector3.new(targetPos.X - standPos.X, 0, targetPos.Z - standPos.Z) or nil
            local hintCF = (hintDelta and hintDelta.Magnitude > 0.05) and CFrame.lookAt(targetPos, targetPos + hintDelta.Unit) or nil
            rawDest = computeClearStandPos(myPlot, targetPos, hintCF, 2.8, nil, hrp.Position, maxReach)
        else
            rawDest = ActivePath.dest
        end
    end

    local routedDest = resolveMineRouteTarget(hrp.Position, rawDest)

    if allowWalkOverride == true or State.MoveMode == "Auto Walk" then
        if hum then
            if hum.SeatPart then hum.Sit = false end
            local dist = (routedDest - hrp.Position).Magnitude
            local recomputeDist = math.max(2.5, math.min(18, dist * 0.15))
            ActivePath.walking = true
            ActivePath.forceWalk = (allowWalkOverride == true)
            local keyChanged = ActivePath.key ~= key
            if allowWalkOverride == true then
                ActivePath.canJump = true
            elseif keyChanged then
                ActivePath.canJump = false
            end
            if keyChanged then
                ActivePath.stallCount = 0
                ActivePath.lastProgressPos = hrp.Position
                ActivePath.lastProgressAt = now
            end
            local movedTarget = ActivePath.dest and (ActivePath.dest - routedDest).Magnitude > recomputeDist
            local stale = (now - ActivePath.computedAt) > (dist > 60 and 2.5 or 1.0)
            if keyChanged or movedTarget or stale then
                computeWalkPath(key, hrp.Position, routedDest, now, allowWalkOverride == true, targetPos)
            end
            stepAutoWalk(now)
        end
        return false
    end

    -- Auto Teleport
    ActivePath.walking = false
    ActivePath.key = ""
    ActivePath.dest = nil
    ActivePath.targetPos = nil
    if hum and hum.SeatPart then
        hum.Sit = false
    end
    local dest = routedDest
    local lookAt = Vector3.new(targetPos.X, dest.Y, targetPos.Z)
    local cf = (lookAt - dest).Magnitude > 0.1 and CFrame.lookAt(dest, lookAt) or CFrame.new(dest)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = cf
    Cooldowns.moveArriveAt = now + 0.24
    Cooldowns.nextTick = math.max(Cooldowns.nextTick, Cooldowns.moveArriveAt)
    return false
end

