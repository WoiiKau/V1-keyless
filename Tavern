local function isMoveBlocked(key, now)
    local readyAt = key and Cooldowns.walkFail[key]
    return readyAt ~= nil and (now or os.clock()) < readyAt
end

local function isActionSkipped(key, now)
    local st = key and Cooldowns.actionRetry[key]
    return st ~= nil and (now or os.clock()) < (st.skipUntil or 0)
end

local function noteActionAttempt(key, sig, now, maxTries, skipSec)
    if not key then return false end
    local tNow = now or os.clock()
    local st = Cooldowns.actionRetry[key]
    local sigStr = sig ~= nil and tostring(sig) or ""
    if not st or st.sig ~= sigStr or (tNow - (st.lastAt or 0)) > 12.0 then
        Cooldowns.actionRetry[key] = {
            sig = sigStr,
            count = 1,
            lastAt = tNow,
            skipUntil = 0,
        }
        return false
    end
    st.count = (st.count or 0) + 1
    st.lastAt = tNow
    if st.count >= (maxTries or 2) then
        st.skipUntil = tNow + (skipSec or 6.0)
        st.count = 0
        return true
    end
    return false
end

