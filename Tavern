do
local function getHuntShotParams(dist, isPumpkin)
    local drawTime = (Hunting and Hunting.DRAW_TIME) or 0.8
    local nockTime = (Hunting and Hunting.NOCK_TIME) or 1.05
    local minS = (Hunting and Hunting.MIN_STRENGTH) or 0.2
    local extra = OutdoorsState.huntExtraDelay or 0
    if not State.HuntFastBow then
        return 1.0, drawTime + 0.08, nockTime + 0.06
    end
    local d = tonumber(dist) or 60
    local strength
    if isPumpkin and d > 45 then
        strength = math.clamp(0.45 + (d - 45) / 140 + extra * 0.35, 0.45, 1.0)
    else
        strength = math.clamp(minS + 0.04 + math.max(0, d - 15) / 170 + extra * 0.35, minS + 0.04, 1.0)
    end
    local holdSec = strength * drawTime + 0.02 + extra * 0.25
    local nockSec = math.max(0.25, nockTime + 0.015 + extra)
    return strength, holdSec, nockSec
end

local function stepHunting(now, hrp, hum, huntCtx)
    local huntRemote = getRemote("Hunt")
    if not huntRemote then return end

    local ctx = huntCtx or scanHuntingContext(hrp.Position, now)
    local hasBow, bowReady = ensureToolEquipped((Hunting and Hunting.TOOL) or "Hunting Bow")

    if OutdoorsState.drawing then
        -- Keep kiting charging predators while holding draw so packs don't overrun us
        if hasBow then
            stepHuntKiting(now, hrp.Position, hum, hrp, ctx.threats)
        else
            stopHuntKiting(hum, hrp.Position)
        end

        local drawTime = (Hunting and Hunting.DRAW_TIME) or 0.8
        local minS = (Hunting and Hunting.MIN_STRENGTH) or 0.2
        local elapsed = now - OutdoorsState.drawStartedAt
        local targetHold = State.HuntFastBow and (OutdoorsState.drawHoldSec or (drawTime + 0.08)) or (drawTime + 0.08)
        if elapsed >= targetHold then
            local target = getTrackedHuntTarget(OutdoorsState.drawTargetId, OutdoorsState.drawPumpkin, hrp.Position)
            if not target or not hasBow then
                OutdoorsState.drawing = false
                OutdoorsState.drawHoldSec = 0
                huntRemote:FireServer("Cancel")
                return
            end
            local origin = hrp.Position + Vector3.new(0, 1.5, 0)
            local shotS = State.HuntFastBow and math.clamp(elapsed / drawTime, minS, 1.0) or 1.0
            local speed = (Hunting and Hunting.speed and Hunting.speed(shotS)) or (70 + 170 * shotS)
            local dir, t, aimPt = solveBowAim(origin, target.pos, target.vel, speed)
            if (not dir or not t) and State.HuntFastBow and shotS < 0.99 and elapsed < (drawTime + 0.08) then
                OutdoorsState.drawHoldSec = math.min(drawTime + 0.08, targetHold + 0.16)
                return
            end
            if not dir or not t then
                OutdoorsState.drawing = false
                OutdoorsState.drawHoldSec = 0
                huntRemote:FireServer("Cancel")
                return
            end

            OutdoorsState.shotKey = OutdoorsState.shotKey + 1
            local shotKey = 50000 + OutdoorsState.shotKey
            local boneName, relCF = findNearestBoneAndRel(target.visModel, aimPt)
            local clampedT = math.clamp(t, 0.004, 2.5)
            if not target.pumpkin then
                OutdoorsState.lastHuntTargetId = target.id
                OutdoorsState.lastHuntTargetAt = now
                OutdoorsState.lockedTargetId = target.id
                if target.group ~= nil then
                    OutdoorsState.huntGroupId = target.group
                end
            end
            OutdoorsState.pendingShots[shotKey] = {
                animalId = target.id,
                visModel = target.visModel,
                origin = origin,
                dir = dir,
                speed = speed,
                targetPos = aimPt,
                boneName = boneName,
                relCF = relCF,
                t = clampedT,
                pumpkin = target.pumpkin,
                sentAt = now,
            }
            OutdoorsState.drawing = false
            OutdoorsState.drawHoldSec = 0
            local _, _, nockSec = getHuntShotParams(target.dist, target.pumpkin == true)
            OutdoorsState.lastShotSentAt = now
            OutdoorsState.nextShotAt = now + nockSec
            huntRemote:FireServer("Shoot", {
                o = origin,
                d = dir,
                s = shotS,
                k = shotKey,
                c = Workspace:GetServerTimeNow(),
            })
        end
        return
    end

    local target = getHuntTargetCandidate(hrp.Position, now, ctx)
    if not target then
        stopHuntKiting(hum, hrp.Position)
        return
    end
    if not target.pumpkin then
        OutdoorsState.lastHuntTargetId = target.id
        OutdoorsState.lastHuntTargetAt = now
        OutdoorsState.lockedTargetId = target.id
        if target.group ~= nil then
            OutdoorsState.huntGroupId = target.group
        end
    end

    local approachRange = hasBow and (target.pumpkin and 95 or ((target.species == "Bear" or target.species == "Wolf") and 140 or 90)) or 18
    if target.dist > approachRange then
        stopHuntKiting(hum, hrp.Position)
        if State.HuntWalkToTarget then
            ensureWithinRange("hunt:" .. tostring(target.id), target.pos, target.pos, now, approachRange, true)
        elseif not hasBow and now - OutdoorsState.lastToolWarnAt >= 8 then
            OutdoorsState.lastToolWarnAt = now
            Window:Notify("Outdoors · Hunting", "Waiting for Hunting Bow (move outside town/plots into the wilds).")
        end
        return
    end

    if not hasBow then
        stopHuntKiting(hum, hrp.Position)
        if now - OutdoorsState.lastToolWarnAt >= 8 then
            OutdoorsState.lastToolWarnAt = now
            Window:Notify("Outdoors · Hunting", "Waiting for Hunting Bow (move outside town/plots into the wilds).")
        end
        return
    end

    if ActivePath.walking then
        stopAutoWalk(hum, hrp)
    end

    local isKitingNow = stepHuntKiting(now, hrp.Position, hum, hrp, ctx.threats)
    if not bowReady or now < OutdoorsState.nextShotAt then return end

    if not isKitingNow then
        pcall(function()
            local flatTarget = Vector3.new(target.pos.X, hrp.Position.Y, target.pos.Z)
            if horizontalDist(hrp.Position, flatTarget) > 1.0 then
                hrp.CFrame = CFrame.lookAt(hrp.Position, flatTarget)
            end
        end)
    end

    local _, holdSec = getHuntShotParams(target.dist, target.pumpkin == true)
    OutdoorsState.drawing = true
    OutdoorsState.drawStartedAt = now
    OutdoorsState.drawHoldSec = holdSec
    OutdoorsState.drawTargetId = target.id
    OutdoorsState.drawPumpkin = target.pumpkin == true
    huntRemote:FireServer("Draw")
end

local function stepFishing(now, hrp, hum)
    if OutdoorsState.fishCastId then return end
    if now < OutdoorsState.fishNextCastAt then return end

    local fishRemote = getRemote("Fish")
    if not fishRemote then return end

    local waterPos = findWaterCastPoint(hrp)
    if not waterPos then
        if State.FishWalkToWater then
            local bankPos = getFishingBankAnchor(hrp.Position)
            if ensureWithinRange("fish_bank", bankPos, bankPos, now, 7.0, true) then
                waterPos = findWaterCastPoint(hrp)
            end
        end
        if not waterPos then return end
    end

    if ActivePath.walking then
        stopAutoWalk(hum, hrp)
    end

    local hasRod, rodReady = ensureToolEquipped((FishingConfig and FishingConfig.ROD) or "Fishing Rod")
    if not hasRod then
        if now - OutdoorsState.fishToolWarnAt >= 8 then
            OutdoorsState.fishToolWarnAt = now
            Window:Notify("Outdoors · Fishing", "Waiting for Fishing Rod near water.")
        end
        return
    end
    if not rodReady then return end

    if hum and hum.SeatPart then
        hum.Sit = false
    end
    pcall(function()
        local flatLook = Vector3.new(waterPos.X, hrp.Position.Y, waterPos.Z)
        if horizontalDist(hrp.Position, flatLook) > 1.0 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, flatLook)
        end
    end)

    OutdoorsState.fishNextCastAt = now + 2.5
    fishRemote:FireServer("Cast", waterPos)
end

local function stepMining(now, hrp, hum)
    local mineRemote = getRemote("MineNode")
    if not mineRemote then return end

    if OutdoorsState.miningNodeId then
        if now < OutdoorsState.miningUntil then
            return
        end
        OutdoorsState.miningNodeId = nil
    end

    local node = pickBestGemNode(hrp.Position, now)
    if not node then
        if State.MineWalkToNodes and hrp.Position.Y > -45 then
            local cavernCenter = Vector3.new(420, -58.5, -355)
            ensureWithinRange("mine_cavern", cavernCenter, cavernCenter, now, 18.0, true)
        end
        return
    end

    local approachDist = node.standDist + 0.7
    if not ensureWithinRange("mine_node:" .. tostring(node.id), node.pos, node.pos, now, approachDist, State.MineWalkToNodes) then
        return
    end

    local hasPick = findOwnedTool("Pickaxe") ~= nil
    if not hasPick then
        if now - OutdoorsState.mineToolWarnAt >= 8 then
            OutdoorsState.mineToolWarnAt = now
            Window:Notify("Outdoors · Mining", "Waiting for Pickaxe inside Gem Mine.")
        end
        return
    end

    if now < OutdoorsState.nextMineFireAt then return end
    OutdoorsState.nextMineFireAt = now + 0.75
    OutdoorsState.miningNodeId = node.id
    OutdoorsState.miningUntil = now + 9.0
    pcall(function()
        local flatLook = Vector3.new(node.pos.X, hrp.Position.Y, node.pos.Z)
        if horizontalDist(hrp.Position, flatLook) > 0.5 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, flatLook)
        end
    end)
    mineRemote:FireServer(node.id)
end

local function recordHuntDeathTarget(now)
    if OutdoorsState.lastHuntTargetId and (now - (OutdoorsState.lastHuntTargetAt or 0)) <= 25 and now >= (OutdoorsState.lastDeathRecordedAt or 0) then
        Cooldowns.huntSkip[OutdoorsState.lastHuntTargetId] = now + 60
        OutdoorsState.lastDeathRecordedAt = now + 2.5
        OutdoorsState.lastHuntTargetId = nil
    end
end

bindCharacterDeath = function(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if hum then
        trackConn(hum.Died:Connect(function()
            if not Running then return end
            recordHuntDeathTarget(os.clock())
            stopAutoWalk(nil, nil)
            resetOutdoorsState(false)
        end))
    end
end

runOutdoorsStep = function(now)
    local hrp, hum = getPlayerRoot()
    if not hrp or not hum or hum.Health <= 0 then
        recordHuntDeathTarget(now)
        if ActivePath.walking then
            stopAutoWalk(hum, hrp)
        end
        resetOutdoorsState(false)
        return
    end

    local huntCtx = (State.AutoHunt or State.AutoCollectKills) and scanHuntingContext(hrp.Position, now) or nil

    if State.AutoCollectKills then
        local busyCollecting = stepCollectKills(now, hrp.Position, hum, hrp, huntCtx)
        if busyCollecting then return end
    end

    if State.AutoMine then
        stopHuntKiting(hum, hrp.Position)
        stepMining(now, hrp, hum)
        return
    end

    if State.AutoFish then
        stopHuntKiting(hum, hrp.Position)
        stepFishing(now, hrp, hum)
        return
    end

    if State.AutoHunt then
        stepHunting(now, hrp, hum, huntCtx)
    else
        stopHuntKiting(hum, hrp.Position)
    end
end
end

local function fireHuntHitPayload(shotId, shot)
    local huntRemote = getRemote("Hunt")
    if not huntRemote or not shot then return end
    local hitT = math.clamp(shot.t or 0.05, 0.004, 2.5)
    local hitPos = shot.targetPos
    if Hunting and Hunting.at and shot.origin and shot.dir and shot.speed then
        hitPos = Hunting.at(shot.origin, shot.dir * shot.speed, hitT)
    end

    if shot.pumpkin then
        huntRemote:FireServer("PumpkinHit", {
            id = shotId,
            p = hitPos,
            t = hitT,
            o = shot.relCF or CFrame.identity,
        })
    else
        local bone, rel = findNearestBoneAndRel(shot.visModel, hitPos)
        huntRemote:FireServer("Hit", {
            id = shotId,
            a = shot.animalId,
            p = hitPos,
            t = hitT,
            o = rel,
            b = bone or shot.boneName or "center",
        })
    end
end

