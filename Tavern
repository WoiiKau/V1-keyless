local function getPlotLevelFolders(plot)
    local includeList = {}
    local tavern = plot and plot:FindFirstChild("Tavern")
    if not tavern then return includeList end
    for _, child in ipairs(tavern:GetChildren()) do
        if child.Name:match("^Level%d+$") then
            table.insert(includeList, child)
        end
    end
    return includeList
end

local function getFloorHitForPlot(plot, xzPos, approxY, includeList)
    local folders = includeList or getPlotLevelFolders(plot)
    if #folders == 0 then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = folders

    local origin = Vector3.new(xzPos.X, (approxY or 2.0) + 5.0, xzPos.Z)
    return Workspace:Raycast(origin, Vector3.new(0, -14, 0), params)
end

local function getFloorYForPlot(plot, xzPos, approxY)
    local fallbackY = (approxY or 2.0) + 1.2
    local hit = getFloorHitForPlot(plot, xzPos, approxY)
    if hit then
        return hit.Position.Y + 3.0
    end
    return fallbackY
end

local isWallBlockedBetween, computeClearStandPos
do
local PlotWallCache = setmetatable({}, { __mode = "k" })

local function getPlotWallInstances(plot)
    if not plot then return {} end
    local now = os.clock()
    local cached = PlotWallCache[plot]
    if cached and (now - cached.at) < 1.0 then
        return cached.walls
    end
    local walls = {}
    for _, folder in ipairs(getPlotLevelFolders(plot)) do
        for _, child in ipairs(folder:GetChildren()) do
            -- Match ReplicatedStorage.Shared.WallSight ("Wall " parts only; ignore pillars/beams/trims)
            if string.sub(child.Name, 1, 5) == "Wall " then
                table.insert(walls, child)
            end
        end
    end
    PlotWallCache[plot] = { at = now, walls = walls }
    return walls
end

isWallBlockedBetween = function(plot, posA, posB)
    if not plot or not posA or not posB then return false end
    local delta = Vector3.new(posB.X - posA.X, 0, posB.Z - posA.Z)
    local mag = delta.Magnitude
    if mag < 0.7 then return false end

    local walls = getPlotWallInstances(plot)
    if #walls == 0 then return false end

    local folders = getPlotLevelFolders(plot)
    local hitA = #folders > 0 and getFloorHitForPlot(plot, posA, posA.Y, folders) or nil
    local floorY = hitA and hitA.Position.Y or (math.min(posA.Y, posB.Y) - 2.4)
    local origin = Vector3.new(posA.X, floorY + 2.4, posA.Z)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = walls
    params.IgnoreWater = true

    -- Stop slightly short of posB so wall-adjacent counters, basins, or seats do not graze the wall behind them
    local hit = Workspace:Raycast(origin, delta.Unit * math.max(0.1, mag - 0.65), params)
    if not hit or not hit.Instance then return false end
    return (hit.Instance.Position.Y + hit.Instance.Size.Y * 0.5) > (floorY + 0.6)
end

local function computeStandPos(plot, pivotCF, offsetStuds)
    local targetPos = pivotCF.Position
    local standXZ = targetPos
    if offsetStuds and offsetStuds > 0 then
        local look = pivotCF.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.05 then
            standXZ = targetPos - flatLook.Unit * offsetStuds
        end
    end
    local standY = getFloorYForPlot(plot, standXZ, targetPos.Y)
    return Vector3.new(standXZ.X, standY, standXZ.Z)
end

-- Probe 8 directions and reach radii so packed tables, chairs, shelves, or back walls never trap Auto Walk/TP
computeClearStandPos = function(plot, targetPos, pivotCF, offsetStuds, excludeModel, fromPos, maxReach)
    if not plot then
        return pivotCF and computeStandPos(plot, pivotCF, offsetStuds) or targetPos
    end

    local maxR = math.max(2.4, (maxReach or State.MaxReach) - 0.8)
    local pref = math.clamp(offsetStuds or 3.0, 2.2, maxR)
    local radii = { pref }
    for _, candR in ipairs({ 2.5, 3.2, 4.0, 4.6 }) do
        if candR <= maxR then
            local unique = true
            for _, existing in ipairs(radii) do
                if math.abs(existing - candR) < 0.45 then
                    unique = false
                    break
                end
            end
            if unique then
                table.insert(radii, candR)
            end
        end
    end

    local fwd = nil
    if pivotCF then
        local look = pivotCF.LookVector
        local flat = Vector3.new(-look.X, 0, -look.Z)
        if flat.Magnitude > 0.05 then
            fwd = flat.Unit
        end
    end
    if not fwd and fromPos then
        local toPlayer = Vector3.new(fromPos.X - targetPos.X, 0, fromPos.Z - targetPos.Z)
        if toPlayer.Magnitude > 0.05 then
            fwd = toPlayer.Unit
        end
    end
    fwd = fwd or Vector3.new(0, 0, 1)
    local right = Vector3.new(-fwd.Z, 0, fwd.X)
    local candidates = {
        fwd,
        (fwd + right).Unit,
        (fwd - right).Unit,
        right,
        -right,
        (-fwd + right).Unit,
        (-fwd - right).Unit,
        -fwd,
    }

    local folders = getPlotLevelFolders(plot)
    local hasFloors = #folders > 0
    local walls = getPlotWallInstances(plot)
    local hasWalls = #walls > 0
    local wallParams = RaycastParams.new()
    wallParams.FilterType = Enum.RaycastFilterType.Include
    wallParams.FilterDescendantsInstances = walls
    wallParams.IgnoreWater = true

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    local overlapExclude = {}
    if LocalPlayer.Character then table.insert(overlapExclude, LocalPlayer.Character) end
    overlapParams.FilterDescendantsInstances = overlapExclude

    local tavern = plot:FindFirstChild("Tavern")
    local propsFolder = tavern and tavern:FindFirstChild("Props")
    local targetFloorHit = hasFloors and getFloorHitForPlot(plot, targetPos, targetPos.Y, folders) or nil
    local targetFloorY = targetFloorHit and targetFloorHit.Position.Y or (targetPos.Y - 1.5)

    local bestClear, bestClearScore = nil, math.huge
    local bestNonWall, bestNonWallScore = nil, math.huge

    for _, radius in ipairs(radii) do
        for angleIdx, dirUnit in ipairs(candidates) do
            local candXZ = Vector3.new(targetPos.X + dirUnit.X * radius, 0, targetPos.Z + dirUnit.Z * radius)
            local floorHit = hasFloors and getFloorHitForPlot(plot, candXZ, targetPos.Y, folders) or nil
            if (not hasFloors) or (floorHit and math.abs(floorHit.Position.Y - targetFloorY) <= 2.5) then
                local candFloorY = floorHit and floorHit.Position.Y or targetFloorY
                local standY = floorHit and (floorHit.Position.Y + 3.0) or getFloorYForPlot(plot, candXZ, targetPos.Y)
                local candPos = Vector3.new(candXZ.X, standY, candXZ.Z)

                local wallBlocked = false
                if hasWalls then
                    local seg = Vector3.new(candPos.X - targetPos.X, 0, candPos.Z - targetPos.Z)
                    local segMag = seg.Magnitude
                    if segMag >= 0.7 then
                        local wOrigin = Vector3.new(targetPos.X, candFloorY + 2.4, targetPos.Z)
                        local wHit = Workspace:Raycast(wOrigin, seg.Unit * math.max(0.1, segMag - 0.65), wallParams)
                        if wHit and wHit.Instance and (wHit.Instance.Position.Y + wHit.Instance.Size.Y * 0.5) > (candFloorY + 0.6) then
                            wallBlocked = true
                        end
                    end
                end

                if not wallBlocked then
                    local walkDist = fromPos and horizontalDist(fromPos, candPos) or radius
                    local score = walkDist * 0.65 + (angleIdx - 1) * 0.25 + math.abs(radius - pref) * 0.4
                    if score < bestNonWallScore then
                        bestNonWallScore = score
                        bestNonWall = candPos
                    end

                    local parts = Workspace:GetPartBoundsInRadius(Vector3.new(candXZ.X, candFloorY + 2.25, candXZ.Z), 0.95, overlapParams)
                    local obstructed = false
                    for _, bp in ipairs(parts) do
                        local isPropPart = (propsFolder and bp:IsDescendantOf(propsFolder)) or PropNoclipSavedParts[bp] ~= nil
                        local isCollidable = bp.CanCollide or (PropNoclipSavedParts[bp] ~= nil)
                        if isCollidable and (isPropPart or (bp.Position.Y + bp.Size.Y * 0.5) > (candFloorY + 0.6)) then
                            obstructed = true
                            break
                        end
                    end

                    if not obstructed and score < bestClearScore then
                        bestClearScore = score
                        bestClear = candPos
                    end
                end
            end
        end
    end

    if bestClear then return bestClear end
    if bestNonWall then return bestNonWall end
    return pivotCF and computeStandPos(plot, pivotCF, pref) or Vector3.new(targetPos.X, targetFloorY + 3.0, targetPos.Z)
end
end

local function scoreTargetForPlayer(plot, hrpPos, pos, standPos, moveKey, now, extraPenalty)
    if not pos then return math.huge end
    local refPos = standPos or pos
    local score = extraPenalty or 0
    if hrpPos then
        score = score + horizontalDist(hrpPos, refPos)
        local floorDiff = math.abs(hrpPos.Y - pos.Y)
        if floorDiff > 6.5 then
            score = score + 2000 + floorDiff * 20
        end
        if plot and isWallBlockedBetween(plot, hrpPos, refPos) then
            score = score + 450
        end
    end
    if moveKey and now and isMoveBlocked(moveKey, now) then
        score = score + 1500
    end
    return score
end

local function makePropTarget(plot, model, offsetStuds, spotName, fromPos, customPos)
    if not model then return nil end
    local piv = model:GetPivot()
    local pos = customPos
    if not pos then
        local spot = spotName and model:FindFirstChild(spotName, true)
        pos = (spot and spot:IsA("Attachment")) and spot.WorldPosition or piv.Position
    end
    local uid = model:GetAttribute("Uid")
    return {
        model = model,
        uid = uid,
        key = tostring(uid or model.Name),
        pos = pos,
        standPos = computeClearStandPos(plot, pos, piv, offsetStuds or 3.2, model, fromPos),
    }
end

local findBarTarget, findBasinTarget
do
local function isBarProp(model, def, info)
    return def == "Bar" or def == "BarSet" or (info and info.station == "Bar")
end

local function isBasinProp(model, def, info)
    if type(def) ~= "string" then return false end
    if def == "BarBasin" or def == "Basin" then return true end
    return info ~= nil and (info.station == "Basin" or (info.stations and info.stations.Basin ~= nil))
end

local function findBestPlotProp(ownerId, matcherFn, offsetStuds, spotName, movePrefix, fromPos)
    local plot, props = getPlotProps(ownerId)
    if not props then return nil end
    local refPos = fromPos
    if not refPos then
        local hrp = getPlayerRoot()
        refPos = hrp and hrp.Position
    end
    local now = os.clock()
    local bestTarget, bestScore = nil, math.huge
    for _, model in ipairs(props:GetChildren()) do
        if model:IsA("Model") then
            local def = model:GetAttribute("Def")
            local info = type(def) == "string" and Furniture and Furniture[def] or nil
            if matcherFn(model, def, info) then
                local cand = makePropTarget(plot, model, offsetStuds, spotName, refPos)
                if cand then
                    local moveKey = movePrefix and (movePrefix .. cand.key) or nil
                    local score = scoreTargetForPlayer(plot, refPos, cand.pos, cand.standPos, moveKey, now)
                    if score < bestScore then
                        bestScore = score
                        bestTarget = cand
                    end
                end
            end
        end
    end
    return bestTarget
end

findBarTarget = function(ownerId, barUid, fromPos)
    local plot, props = getPlotProps(ownerId)
    if not props then return nil end
    if not fromPos then
        local hrp = getPlayerRoot()
        fromPos = hrp and hrp.Position
    end
    if barUid then
        local wantedName = "Prop " .. tostring(barUid)
        for _, model in ipairs(props:GetChildren()) do
            if model:IsA("Model") then
                local uid = model:GetAttribute("Uid")
                if uid == barUid or model.Name == wantedName then
                    return makePropTarget(plot, model, 3.4, "BarSpot", fromPos)
                end
            end
        end
    end
    return findBestPlotProp(ownerId, isBarProp, 3.4, "BarSpot", "bar:", fromPos)
end

findBasinTarget = function(ownerId, fromPos)
    return findBestPlotProp(ownerId, isBasinProp, 3.2, "BasinSpot", "basin:", fromPos)
end
end

local getPlotKitchenInfo
do
local COOK_STATIONS = {
