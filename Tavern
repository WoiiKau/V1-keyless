        -- Slider

        function targetObj:CreateSlider(label, flag, minVal, maxVal, initVal, step, onChange)

            if type(flag) == "number" then

                onChange = step

                step = initVal

                initVal = maxVal

                maxVal = minVal

                minVal = flag

                flag = label:gsub("%s+", ""):lower()

            end

            flag = flag or label:gsub("%s+", ""):lower()

            step = step or 1

            initVal = (NexUI.Config[flag] ~= nil) and NexUI.Config[flag] or (initVal or minVal)

            NexUI.Config[flag] = initVal



            local card = make("Frame", {

                Size = UDim2.new(1, 0, 0, 48),

                BackgroundColor3 = C.card,

                BorderSizePixel = 0,

            }, targetFrame)

            corner(6, card)

