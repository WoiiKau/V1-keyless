local function parseKitchenHeld(plot)
    local held = {}
    if not plot then return held end
    local attr = plot:GetAttribute("KitchenHeld")
    if type(attr) ~= "string" or attr == "" then
        return held
    end
    for _, entry in ipairs(string.split(attr, ",")) do
