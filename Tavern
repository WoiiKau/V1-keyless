local function getLiveWorldPartAndPos(inst, preferPivot)
    if not inst or not inst.Parent then return nil, nil end
    if inst:IsA("BasePart") then
        return inst, inst.Position
    end
    if preferPivot and inst:IsA("Model") then
        local piv = inst:GetPivot().Position
        if piv.Magnitude > 0.5 then
            return inst:FindFirstChildWhichIsA("BasePart", true) or inst.PrimaryPart, piv
        end
    end
    local bp = (inst:IsA("Model") and inst.PrimaryPart) or inst:FindFirstChildWhichIsA("BasePart", true)
    if bp then
        return bp, bp.Position
    end
    if inst:IsA("Model") then
        return nil, inst:GetPivot().Position
    end
    return nil, nil
end

local function resolveWorldGroundY(x, z, hintY, includeMine, includeHub, skipPlots)
    local includeList = {}
    if Workspace.Terrain then table.insert(includeList, Workspace.Terrain) end
    local world = Workspace:FindFirstChild("World")
    if world then
        local bridges = world:FindFirstChild("Bridges")
        if bridges then table.insert(includeList, bridges) end
        if includeMine then
            local mine = world:FindFirstChild("Mine")
            if mine then table.insert(includeList, mine) end
        end
        if includeHub then
            local hub = world:FindFirstChild("Hub")
            if hub then table.insert(includeList, hub) end
        end
    end
    if not skipPlots then
        local plots = Workspace:FindFirstChild("Plots")
        if plots then table.insert(includeList, plots) end
    end

    if #includeList > 0 then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = includeList
        local startY = hintY or 90
        local hit = Workspace:Raycast(Vector3.new(x, startY, z), Vector3.new(0, -240, 0), params)
        if hit then
            return hit.Position.Y
        end
    end
    return hintY and (hintY - 14) or 0
end

local restoreCollision
local restoreWalkSpeed

local function resetTravelState()
    TravelState.active = false
    TravelState.destPos = nil
    TravelState.lookAt = nil
    TravelState.refreshBarTarget = false
    TravelState.keepDestY = false
    TravelState.waypoints = {}
    TravelState.wpIdx = 2
    TravelState.pathSeq = TravelState.pathSeq + 1
    TravelState.computing = false
    TravelState.nextPathAt = 0
    TravelState.lastProgressPos = nil
    TravelState.lastProgressAt = 0
    TravelState.noclipGraceUntil = 0
end

local function finishTravel(hrp, hum, label)
    if hum and hrp then
        stopAutoWalk(hum, hrp)
    end
    resetTravelState()
    if not State.Noclip and restoreCollision then
        restoreCollision()
    end
    if not State.EnableWalkSpeed and restoreWalkSpeed then
        restoreWalkSpeed()
    end
    if label then
        Window:Notify("Fast Travel", "Arrived at " .. tostring(label) .. "!")
    end
end

local function cancelTravel(silent)
    local wasActive = TravelState.active
    local hrp, hum = getPlayerRoot()
    finishTravel(hrp, hum, nil)
    if wasActive and not silent then
        Window:Notify("Fast Travel", "Cancelled travel.")
    end
end

local function computeTravelPath(fromPos, destPos)
    if TravelState.computing then return end
    TravelState.computing = true
    TravelState.pathSeq = TravelState.pathSeq + 1
    local mySeq = TravelState.pathSeq

    task.spawn(function()
        local routedDest = resolveMineRouteTarget(fromPos, destPos)
        local wps = createComputedWaypoints(fromPos, routedDest, 1.5, true)
        if TravelState.active and TravelState.pathSeq == mySeq then
            TravelState.waypoints = wps
            TravelState.wpIdx = (#TravelState.waypoints >= 2) and 2 or 1
        end
        TravelState.computing = false
    end)
end

local stepTravel
do
local function stepTravelWalk(now, hrp, hum, curPos, destPos, dist3D)
    if not hum then
        cancelTravel(true)
        return
    end
    local horizDist = horizontalDist(curPos, destPos)
    if dist3D <= 5.5 or (horizDist <= 5.0 and math.abs(destPos.Y - curPos.Y) <= 8.5) then
        finishTravel(hrp, hum, TravelState.label)
        return
    end

    if not TravelState.lastProgressPos or (curPos - TravelState.lastProgressPos).Magnitude >= 2.0 then
        TravelState.lastProgressPos = curPos
        TravelState.lastProgressAt = now
    elseif now - TravelState.lastProgressAt >= 1.8 then
        if hum.FloorMaterial ~= Enum.Material.Air then
            hum.Jump = true
        end
        TravelState.noclipGraceUntil = now + 1.15
        TravelState.lastProgressAt = now
        TravelState.nextPathAt = math.min(TravelState.nextPathAt, now + 0.35)
    end

    local routedDest = resolveMineRouteTarget(curPos, destPos)
    if not TravelState.computing and now >= TravelState.nextPathAt then
        TravelState.nextPathAt = now + 3.2
        computeTravelPath(curPos, routedDest)
    end

    local wps = TravelState.waypoints
    while TravelState.wpIdx < #wps do
        local wpPos = wps[TravelState.wpIdx].Position
        if horizontalDist(curPos, wpPos) <= 4.5 and math.abs(wpPos.Y - curPos.Y) <= 7.0 then
            TravelState.wpIdx = TravelState.wpIdx + 1
        else
            break
        end
    end

    local activeWp = wps[TravelState.wpIdx]
    if activeWp and activeWp.Action == Enum.PathWaypointAction.Jump and hum.FloorMaterial ~= Enum.Material.Air then
        hum.Jump = true
    end

    hum:MoveTo(activeWp and activeWp.Position or routedDest)
end

local function stepTravelGlide(now, hrp, hum, curPos, destPos, dist3D)
    local dt = math.clamp(now - (TravelState.lastStepAt or now), 0, 0.055)
    TravelState.lastStepAt = now

    if dist3D <= 2.5 then
        local finalPos = destPos
        if not TravelState.keepDestY then
            local groundY = resolveWorldGroundY(destPos.X, destPos.Z, destPos.Y + 8, TravelState.includeMine, TravelState.includeHub, true)
            finalPos = Vector3.new(destPos.X, groundY + 3.2, destPos.Z)
        end
        local lookAt = TravelState.lookAt
        local cf
        if lookAt then
            local flatLook = Vector3.new(lookAt.X, finalPos.Y, lookAt.Z)
            if (flatLook - finalPos).Magnitude > 0.1 then
                cf = CFrame.lookAt(finalPos, flatLook)
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = cf or CFrame.new(finalPos)
        finishTravel(hrp, hum, TravelState.label)
        return
    end

    local horizDist = horizontalDist(curPos, destPos)
    local aimPos = destPos
    if horizDist > 24 then
        local flatDelta = Vector3.new(destPos.X - curPos.X, 0, destPos.Z - curPos.Z)
        local flatDir = flatDelta.Unit
        local probeDist = math.min(horizDist, 14)
        local groundY = resolveWorldGroundY(
            curPos.X + flatDir.X * probeDist,
            curPos.Z + flatDir.Z * probeDist,
            math.max(curPos.Y, destPos.Y) + 32,
            TravelState.includeMine,
            TravelState.includeHub,
            true
        )
        local targetY = groundY + 4.0
        local flatStep = flatDir * math.min(horizDist, 32)
        aimPos = Vector3.new(curPos.X + flatStep.X, targetY, curPos.Z + flatStep.Z)
    end

    local delta = aimPos - curPos
    local maxStep = 33 * dt
    local nextPos = delta.Magnitude <= maxStep and aimPos or (curPos + delta.Unit * maxStep)

    local flatDir = Vector3.new(delta.X, 0, delta.Z)
    local cf = flatDir.Magnitude > 0.1
        and CFrame.lookAlong(nextPos, flatDir.Unit)
        or CFrame.new(nextPos)

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = cf
end

stepTravel = function(now)
    if not TravelState.active or not TravelState.destPos then return end
    local hrp, hum = getPlayerRoot()
    if not hrp then
        cancelTravel(true)
        return
    end
    if hum and hum.SeatPart then
        hum.Sit = false
    end

    local curPos = hrp.Position
    if TravelState.refreshBarTarget and horizontalDist(curPos, TravelState.destPos) < 260 then
        local barTarget = findBarTarget(LocalPlayer.UserId, nil)
        if barTarget then
            TravelState.destPos = barTarget.standPos
            TravelState.lookAt = barTarget.pos
            TravelState.refreshBarTarget = false
            TravelState.keepDestY = true
            TravelState.waypoints = {}
            TravelState.nextPathAt = 0
        end
    end

    local destPos = TravelState.destPos
    local dist3D = (destPos - curPos).Magnitude

    if TravelState.mode == "Auto Walk" then
        stepTravelWalk(now, hrp, hum, curPos, destPos, dist3D)
    else
        stepTravelGlide(now, hrp, hum, curPos, destPos, dist3D)
    end
end
end

local function teleportCharacter(destPos, lookAtPos, travelLabel, includeMine, includeHub, refreshBarTarget)
    local hrp, hum = getPlayerRoot()
    if not hrp then return false, "Character not loaded." end

    stopAutoWalk(hum, hrp)
    if hum and hum.SeatPart then
        hum.Sit = false
    end

    local dist = (destPos - hrp.Position).Magnitude
    if dist <= 34 and not refreshBarTarget then
        finishTravel(hrp, hum, nil)
        local cf
        if lookAtPos then
            local flatLook = Vector3.new(lookAtPos.X, destPos.Y, lookAtPos.Z)
            if (flatLook - destPos).Magnitude > 0.1 then
                cf = CFrame.lookAt(destPos, flatLook)
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = cf or CFrame.new(destPos)
        return true, "Teleported to " .. tostring(travelLabel or "destination") .. "!"
    end

    local mode = State.TravelMode or "Auto Walk"
    TravelState.active = true
    TravelState.mode = mode
    TravelState.label = travelLabel or "destination"
    TravelState.destPos = destPos
    TravelState.lookAt = lookAtPos
    TravelState.includeMine = includeMine == true
    TravelState.includeHub = includeHub == true
    TravelState.refreshBarTarget = refreshBarTarget == true
    TravelState.keepDestY = travelLabel == "Own Tavern (Bar)" and not refreshBarTarget
    TravelState.waypoints = {}
    TravelState.wpIdx = 2
    TravelState.pathSeq = TravelState.pathSeq + 1
    TravelState.computing = false
    TravelState.nextPathAt = 0
    TravelState.lastProgressPos = hrp.Position
    TravelState.lastProgressAt = os.clock()
    TravelState.noclipGraceUntil = 0
    TravelState.lastStepAt = os.clock()

    if mode == "Auto Walk" then
        computeTravelPath(hrp.Position, destPos)
        TravelState.nextPathAt = os.clock() + 3.2
        local estSec = math.max(1, math.ceil(dist / 30))
        return true, "Walking to " .. TravelState.label .. " (~" .. tostring(estSec) .. "s)..."
    end

    local estSec = math.max(1, math.ceil(dist / 33))
    return true, "Gliding safely to " .. TravelState.label .. " (~" .. tostring(estSec) .. "s)..."
end

local function getPlotVisitTarget(plot)
    if not plot then return nil end
    local plotCenter = plot:GetPivot().Position
    local sign = plot:FindFirstChild("OwnerSign")
    if sign then
        local signPos = sign:GetPivot().Position
        local flatDir = Vector3.new(plotCenter.X - signPos.X, 0, plotCenter.Z - signPos.Z)
        local dirUnit = flatDir.Magnitude > 0.5 and flatDir.Unit or Vector3.new(0, 0, 1)
        local sideUnit = Vector3.new(-dirUnit.Z, 0, dirUnit.X)
        local standXZ = signPos - dirUnit * 4.0 + sideUnit * 2.5
        local groundY = resolveWorldGroundY(standXZ.X, standXZ.Z, signPos.Y + 12, false, false)
        return Vector3.new(standXZ.X, groundY + 3.2, standXZ.Z), Vector3.new(plotCenter.X, groundY + 3.2, plotCenter.Z)
    end
    local groundY = resolveWorldGroundY(plotCenter.X, plotCenter.Z, plotCenter.Y + 25, false, false)
    return Vector3.new(plotCenter.X, groundY + 3.2, plotCenter.Z), plotCenter
end

local teleportToZone
do
local STATIC_ZONES = {
    ["Town Square (Plaza)"] = { x = 0, z = 125, hintY = 30, look = Vector3.new(0, 3, 20) },
    ["Town Fountain"] = { x = 0, z = 42, hintY = 30, look = Vector3.new(0, 3, 20) },
    ["Guild Hall"] = { x = 0, z = -14, hintY = 30, look = Vector3.new(0, 5, -59), includeHub = true },
    ["Forge Shop (Smithy)"] = { x = 76, z = 12, hintY = 30, look = Vector3.new(76, 3, -12) },
    ["Gem Mine (Entrance)"] = { x = 420, z = -108, hintY = 40, look = Vector3.new(420, 15, -97), includeMine = true },
    ["Town Pond (Fishing)"] = { x = -280, z = -72, hintY = 30, look = Vector3.new(-315, 0, -95) },
    ["Campfire (Forest)"] = { x = -300, z = -245, hintY = 30, look = Vector3.new(-302, 3, -258) },
}

teleportToZone = function(zoneName)
    if zoneName == "Own Tavern (Bar)" then
        local barTarget = findBarTarget(LocalPlayer.UserId, nil)
        if barTarget then
            return teleportCharacter(barTarget.standPos, barTarget.pos, zoneName, false, false, false)
        end
        local pos, look = getPlotVisitTarget(findPlotForOwner(LocalPlayer.UserId))
        if pos then
            return teleportCharacter(pos, look, zoneName, false, false, true)
        end
        return false, "Could not locate your plot."
    end

    if zoneName == "Own Tavern (Front Sign)" then
        local pos, look = getPlotVisitTarget(findPlotForOwner(LocalPlayer.UserId))
        if not pos then return false, "Could not locate your plot." end
        return teleportCharacter(pos, look, zoneName, false, false)
    end

    if zoneName == "Gem Mine (Crystal Floor)" then
        local world = Workspace:FindFirstChild("World")
        local gemNodes = world and world:FindFirstChild("GemNodes")
        if gemNodes then
            local node = gemNodes:GetChildren()[1]
            if node then
                local _, nodePos = getLiveWorldPartAndPos(node, true)
                if nodePos then
                    local standX, standZ = nodePos.X + 4.8, nodePos.Z
                    local groundY = resolveWorldGroundY(standX, standZ, nodePos.Y + 14, true, false)
                    return teleportCharacter(Vector3.new(standX, groundY + 3.2, standZ), nodePos, zoneName, true, false)
                end
            end
        end
        zoneName = "Gem Mine (Entrance)"
    end

    if zoneName == "River Bridge" then
        local world = Workspace:FindFirstChild("World")
        local bridges = world and world:FindFirstChild("Bridges")
        local bridge = bridges and (bridges:FindFirstChild("Bridge 3") or bridges:GetChildren()[1])
        if bridge then
            local _, bPos = getLiveWorldPartAndPos(bridge, true)
            if bPos then
                local groundY = resolveWorldGroundY(bPos.X, bPos.Z, bPos.Y + 25, false, false)
                return teleportCharacter(Vector3.new(bPos.X, groundY + 3.2, bPos.Z), Vector3.new(0, groundY + 3.2, 20), zoneName, false, false)
            end
        end
        return false, "Could not locate river bridge."
    end

    local zInfo = STATIC_ZONES[zoneName]
    if not zInfo then return false, "Unknown zone: " .. tostring(zoneName) end
    local groundY = resolveWorldGroundY(zInfo.x, zInfo.z, zInfo.hintY, zInfo.includeMine, zInfo.includeHub)
    return teleportCharacter(Vector3.new(zInfo.x, groundY + 3.2, zInfo.z), zInfo.look, zoneName, zInfo.includeMine, zInfo.includeHub)
end
end

local function visitPlotByIndex(plotNum)
    local plots = Workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild("Plot_" .. tostring(plotNum))
    if not plot then
        return false, "Plot_" .. tostring(plotNum) .. " not found."
    end
    local pos, look = getPlotVisitTarget(plot)
    if not pos then
        return false, "Could not resolve safe landing for Plot_" .. tostring(plotNum)
    end
    local ownerId = plot:GetAttribute("OwnerUserId")
    local ownerName = plot:GetAttribute("OwnerName")
    local targetName = (type(ownerId) == "number" and ownerId > 0)
        and (((type(ownerName) == "string" and ownerName ~= "") and ownerName or ("User " .. tostring(ownerId))) .. "'s Tavern (Plot_" .. tostring(plotNum) .. ")")
        or ("Plot_" .. tostring(plotNum) .. " (For Sale)")
    return teleportCharacter(pos, look, targetName, false, false)
end

local function getGemAsteroidPos()
    local at = Workspace:GetAttribute("GemAsteroidAt")
    return typeof(at) == "Vector3" and at or nil
end

local function getGiantPumpkinPos()
    local pFolder = ReplicatedStorage:FindFirstChild("Pumpkin")
    if pFolder and pFolder:GetAttribute("Active") == true then
        local fromPos = pFolder:GetAttribute("From")
        if typeof(fromPos) == "Vector3" then
            local toPos = pFolder:GetAttribute("To")
            local t0 = pFolder:GetAttribute("T0")
            local speed = pFolder:GetAttribute("Speed")
            if typeof(toPos) == "Vector3" and type(t0) == "number" and type(speed) == "number" and speed > 0 then
                local dist = horizontalDist(fromPos, toPos)
                if dist >= 0.001 then
                    local frac = math.clamp(speed * (Workspace:GetServerTimeNow() - t0), 0, dist) / dist
                    return fromPos:Lerp(toPos, frac)
                end
            end
            return fromPos
        end
    end
    local gp = Workspace:FindFirstChild("GiantPumpkin")
    if gp then
        local _, gpPos = getLiveWorldPartAndPos(gp, false)
        if gpPos then return gpPos end
    end
    return nil
end

local function syncWorldEventAlerts()
    local astAt = getGemAsteroidPos()
    local astKey = astAt and (math.round(astAt.X) .. "," .. math.round(astAt.Z)) or nil
    if astKey ~= EventState.asteroidKey then
        EventState.asteroidKey = astKey
        if astKey and State.AlertWorldEvents then
            Window:Notify("World Event", "Gem Asteroid is active! Use World -> Travel & Events to teleport.")
        end
    end

    local pumpkinAt = getGiantPumpkinPos()
    local pActive = pumpkinAt ~= nil
    if pActive ~= EventState.pumpkinActive then
        EventState.pumpkinActive = pActive
        if pActive and State.AlertWorldEvents then
            Window:Notify("World Event", "Giant Pumpkin spawned! Use World -> Travel & Events to teleport.")
        end
    end
end

local getMineGemNodes
do
local MINE_SIZE_RANK = {
    Large = 3,
    Medium = 2,
    Small = 1,
}

getMineGemNodes = function()
    local nodes = {}
    local seen = {}
    local function inspectNode(inst)
        if seen[inst] or not inst:IsA("Model") or not inst.Parent then return end
        seen[inst] = true
        local nodeId = inst:GetAttribute("NodeId")
        if type(nodeId) ~= "number" then return end
        local pos = inst:GetPivot().Position
        local sizeName = tostring(inst:GetAttribute("NodeSize") or "Medium")
        local standDist = 4.6
        if MineConfig and MineConfig.sizeOf then
            local ok, sInfo = pcall(MineConfig.sizeOf, sizeName)
            if ok and sInfo and type(sInfo.stand) == "number" then
                standDist = sInfo.stand
            end
        end
        table.insert(nodes, {
            id = nodeId,
            model = inst,
            pos = pos,
            sizeName = sizeName,
            rank = MINE_SIZE_RANK[sizeName] or 2,
            standDist = standDist,
            isAsteroid = pos.Y > -20,
        })
    end

    for _, tagged in ipairs(CollectionService:GetTagged("GemNode")) do
        inspectNode(tagged)
    end
    local world = Workspace:FindFirstChild("World")
    local gemFolder = world and world:FindFirstChild("GemNodes")
    if gemFolder then
        for _, child in ipairs(gemFolder:GetChildren()) do
            inspectNode(child)
        end
    end
    return nodes
end
end

local function destroyEspEntry(key)
    local entry = EspCache[key]
    if not entry then return end
    if entry.highlight and entry.highlight.Parent then
        entry.highlight:Destroy()
    end
    if entry.billboard and entry.billboard.Parent then
        entry.billboard:Destroy()
    end
    EspCache[key] = nil
end

local function upsertEspEntry(key, highlightTarget, billboardAdornee, worldPos, color, titleText, hrpPos)
    if not highlightTarget or not highlightTarget.Parent or not billboardAdornee or not billboardAdornee.Parent or not worldPos then
        destroyEspEntry(key)
        return
    end
    local rawDist = hrpPos and (worldPos - hrpPos).Magnitude or nil
    local maxDist = State.EspMaxDistance or 400
    if rawDist and maxDist > 0 and maxDist < 1500 and rawDist > maxDist then
        destroyEspEntry(key)
        return
    end

    local distStuds = rawDist and math.floor(rawDist) or nil
    local fullText = (State.EspShowDistance ~= false and distStuds ~= nil)
        and (titleText .. " · " .. tostring(distStuds) .. "m")
        or titleText
    local bbRange = (maxDist >= 1500 or maxDist <= 0) and 2200 or math.max(50, maxDist)

    local entry = EspCache[key]
    if entry and (entry.target ~= highlightTarget or entry.adornee ~= billboardAdornee) then
        destroyEspEntry(key)
        entry = nil
    end

    if not entry then
        local hl = Instance.new("Highlight")
        hl.Name = "_NexEspHL"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = 0.65
        hl.OutlineTransparency = 0.1
        hl.Adornee = highlightTarget
        hl.Parent = highlightTarget

        local bb = Instance.new("BillboardGui")
        bb.Name = "_NexEspBB"
        bb.Adornee = billboardAdornee
        bb.AlwaysOnTop = true
        bb.Size = UDim2.fromOffset(175, 24)
        bb.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
        bb.MaxDistance = bbRange

        local lbl = Instance.new("TextLabel")
        lbl.Name = "Label"
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 0.35
        lbl.BackgroundColor3 = Color3.fromRGB(14, 16, 24)
        lbl.TextColor3 = color
        lbl.TextStrokeTransparency = 0.2
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.Text = fullText
        lbl.Parent = bb

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 5)
        corner.Parent = lbl

        bb.Parent = billboardAdornee

        EspCache[key] = {
            target = highlightTarget,
            adornee = billboardAdornee,
            highlight = hl,
            billboard = bb,
            label = lbl,
        }
    else
        entry.highlight.FillColor = color
        entry.highlight.OutlineColor = color
        entry.billboard.MaxDistance = bbRange
        entry.label.TextColor3 = color
        entry.label.Text = fullText
    end
end

local updateEspVisuals
do
local WILDLIFE_COLORS = {
    Bear = Color3.fromRGB(255, 175, 45),
    Wolf = Color3.fromRGB(190, 95, 255),
    Stag = Color3.fromRGB(95, 235, 145),
    Doe = Color3.fromRGB(95, 235, 145),
    Boar = Color3.fromRGB(130, 215, 110),
}

local GEM_NODE_COLORS = {
    Large = Color3.fromRGB(255, 95, 225),
    Medium = Color3.fromRGB(85, 210, 255),
    Small = Color3.fromRGB(130, 240, 195),
}

updateEspVisuals = function()
    local seen = {}
    local hrp = getPlayerRoot()
    local hrpPos = hrp and hrp.Position

    if State.EspGemNodes then
        local cur = getCurrentState()
        local nodeBonus = (cur and SkillsConfig and type(SkillsConfig.sum) == "function")
            and math.max(0, math.floor(SkillsConfig.sum(cur.skills, "nodeGems") or 0))
            or 0
        for _, n in ipairs(getMineGemNodes()) do
            local part = getLiveWorldPartAndPos(n.model, true)
            if part then
                local baseVal = (MineConfig and MineConfig.SIZES and MineConfig.SIZES[n.sizeName] and MineConfig.SIZES[n.sizeName].gems) or 1
                local gemVal = baseVal + (n.isAsteroid and 0 or nodeBonus)
                local col = n.isAsteroid and Color3.fromRGB(255, 130, 95) or (GEM_NODE_COLORS[n.sizeName] or GEM_NODE_COLORS.Small)
                local k = "gem:" .. tostring(n.id)
                local tagText = n.sizeName .. " (" .. tostring(gemVal) .. "G)" .. (n.isAsteroid and " [Asteroid]" or "")
                seen[k] = true
                upsertEspEntry(k, n.model, part, n.pos, col, tagText, hrpPos)
            end
        end
    end

    if State.EspWildlife then
        local wildlife = Workspace:FindFirstChild("Wildlife")
        if wildlife then
            local filter = State.EspWildlifeFilterOnly and (type(State.HuntFilter) == "table" and State.HuntFilter) or nil
            for _, animal in ipairs(wildlife:GetChildren()) do
                local part, pos = getLiveWorldPartAndPos(animal, false)
                if part and pos and pos.Magnitude > 1 then
                    local species = animal:GetAttribute("Species") or animal.Name:match("^(%a+)") or animal.Name
                    if not filter or filter[species] then
                        local goldVal = Hunting and Hunting.GOLD and Hunting.GOLD[species]
                        local gemVal = Hunting and Hunting.GEMS and Hunting.GEMS[species]
                        local rewardTag = species
                        if goldVal or gemVal then
                            local parts = {}
                            if goldVal then table.insert(parts, tostring(goldVal) .. "g") end
                            if gemVal then table.insert(parts, tostring(gemVal) .. "G") end
                            rewardTag = species .. " [" .. table.concat(parts, "+") .. "]"
                        end
                        local col = WILDLIFE_COLORS[species] or Color3.fromRGB(225, 225, 200)
                        local k = "wild:" .. animal.Name
                        seen[k] = true
                        upsertEspEntry(k, animal, part, pos, col, rewardTag, hrpPos)
                    end
                end
            end
        end
    end

    if State.EspTroublemakers then
        for _, t in ipairs(getTroublemakers(LocalPlayer.UserId)) do
            if t.body and t.body.Parent and t.pos then
                local part = getLiveWorldPartAndPos(t.body, true) or t.body
                local k = "trouble:" .. tostring(t.id)
                seen[k] = true
                upsertEspEntry(k, t.body, part, t.pos, Color3.fromRGB(255, 85, 85), t.label, hrpPos)
            end
        end
    end

    for k in pairs(EspCache) do
        if not seen[k] then
            destroyEspEntry(k)
        end
    end
end
end

restoreWalkSpeed = function()
    local _, hum = getPlayerRoot()
    if not hum then return end
    local cur = getCurrentState()
    if cur and Perks and Perks.walkSpeed then
        local ok, spd = pcall(Perks.walkSpeed, cur.skills)
        if ok and type(spd) == "number" then
            hum.WalkSpeed = spd
            return
        end
    end
    if EventState.origWalkSpeed then
        hum.WalkSpeed = EventState.origWalkSpeed
    end
end

restoreCollision = function()
    for part, origCollide in pairs(NoclipSavedParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = origCollide
            end)
        end
    end
    table.clear(NoclipSavedParts)
end

local function isPlayerOverlappingPropParts(hrp)
    if not hrp or next(PropNoclipSavedParts) == nil then return false end
    local list = {}
    for part in pairs(PropNoclipSavedParts) do
        if part and part.Parent then
            table.insert(list, part)
        end
    end
    if #list == 0 then return false end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = list
    return #Workspace:GetPartBoundsInRadius(hrp.Position, 1.45, params) > 0
end

restorePropCollision = function(force)
    if next(PropNoclipSavedParts) == nil then return true end
    if not force then
        local hrp = getPlayerRoot()
        if isPlayerOverlappingPropParts(hrp) then
            Cooldowns.propBypassUntil = math.max(Cooldowns.propBypassUntil, os.clock() + 0.35)
            return false
        end
    end
    for part, origCollide in pairs(PropNoclipSavedParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = origCollide
            end)
        end
    end
    table.clear(PropNoclipSavedParts)
    lastPropScanAt = 0
    return true
end

local function hasBarMovementWork()
    return State.AutoBarServe
        or State.AutoCook
        or State.AutoCookPrep
        or State.AutoCookDeliver
        or State.AutoClearWash
        or State.AutoRefillKegs
        or State.AutoKickTroublemakers
end

local function syncPropCollision(now)
    local cur = getCurrentState()
    local hrp = getPlayerRoot()
    local isBuilding = (cur and cur.building == true)
    local walkEnabled = (State.MoveMode == "Auto Walk" or ActivePath.forceWalk)
    local wantsBypass = Running
        and not isBuilding
        and not TravelState.active
        and not (State.AutoMine or State.AutoFish or State.AutoHunt)
        and hasBarMovementWork()
        and walkEnabled
        and (State.WalkThroughFurniture or now < Cooldowns.propBypassUntil)
        and hrp ~= nil

    if wantsBypass then
        local plot, props = getPlotProps(LocalPlayer.UserId)
        if plot and props and horizontalDist(hrp.Position, plot:GetPivot().Position) <= 160 then
            if (now - lastPropScanAt) >= 0.35 or next(PropNoclipSavedParts) == nil then
                lastPropScanAt = now
                for _, part in ipairs(props:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if PropNoclipSavedParts[part] == nil then
                            PropNoclipSavedParts[part] = part.CanCollide
                        end
                        if part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            else
                for part in pairs(PropNoclipSavedParts) do
                    if not part or not part.Parent then
                        PropNoclipSavedParts[part] = nil
                    elseif part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
            return
        end
    end

    if next(PropNoclipSavedParts) ~= nil then
        restorePropCollision(isBuilding)
    end
end

