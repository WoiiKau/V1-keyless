local function stepFishingMinigame(now)
    if not OutdoorsState.fishCastId then
        if OutdoorsState.fishSpaceHeld then
            setVirtualSpaceHeld(false)
        end
        return
    end

    local phase = OutdoorsState.fishPhase
    local fishRemote = getRemote("Fish")
    local fishGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("FishingGame")
    local canUseVIM = VirtualInputManager ~= nil and UserInputService:GetFocusedTextBox() == nil and fishGui ~= nil

    if phase == "bite" then
        local elapsedBite = now - OutdoorsState.fishBiteAt
        if elapsedBite >= 0.20 then
            if canUseVIM and now >= OutdoorsState.fishHookAttemptAt then
                OutdoorsState.fishHookAttemptAt = now + 0.25
                setVirtualSpaceHeld(true)
                task.delay(0.06, function()
                    if Running then setVirtualSpaceHeld(false) end
                end)
            elseif elapsedBite >= 0.55 and fishRemote and now >= OutdoorsState.fishHookAttemptAt then
                OutdoorsState.fishHookAttemptAt = now + 0.6
                fishRemote:FireServer("Hook", OutdoorsState.fishCastId)
            end
        end
        return
    end

    if phase == "fight" then
        local elapsedFight = now - OutdoorsState.fishFightAt
        local maxLimit = (FishFight and FishFight.maxFor and FishFight.maxFor(OutdoorsState.fishMinSec * (FishFight.DRAIN or 0.9)))
            or math.max(OutdoorsState.fishMinSec * 3.5, 35)
        if elapsedFight >= (maxLimit + 2.0) and fishRemote then
            local doneId = OutdoorsState.fishCastId
            setVirtualSpaceHeld(false)
            OutdoorsState.fishCastId = nil
            OutdoorsState.fishPhase = "idle"
            OutdoorsState.fishNextCastAt = now + 2.2
            fishRemote:FireServer("Caught", doneId)
            if fishGui then
                pcall(function() fishGui:Destroy() end)
            end
            return
        end

        if canUseVIM then
            local needle = fishGui:FindFirstChild("Needle", true)
            local diamond = nil
            if needle then
                for _, child in ipairs(needle:GetChildren()) do
                    if child:IsA("Frame") and child.ZIndex == 15 then
                        diamond = child
                        break
                    end
                end
            end

            if needle and needle.Visible and diamond then
                local tension = math.clamp((needle.Rotation + 115) / 230, 0, 1)
                local col = diamond.BackgroundColor3
                local r, g = col.R * 255, col.G * 255
                local zone = (g >= 200) and "green" or ((r >= 175 and g < 120) and "red" or "low")

                if zone == "green" and not OutdoorsState.fishGreenLow then
                    OutdoorsState.fishGreenLow = math.max(0.40, tension - 0.11)
                    OutdoorsState.fishGreenTop = math.min(0.85, tension + 0.11)
                end
                if OutdoorsState.fishLastZone == "low" and zone == "green" then
                    OutdoorsState.fishGreenLow = tension
                elseif OutdoorsState.fishLastZone == "green" and zone == "red" then
                    OutdoorsState.fishGreenTop = tension
                end
                OutdoorsState.fishLastZone = zone

                local wantHold
                if zone == "red" then
                    wantHold = false
                elseif zone == "low" then
                    wantHold = true
                else
                    local gLow = OutdoorsState.fishGreenLow or 0.48
                    local gTop = OutdoorsState.fishGreenTop or 0.72
                    local targetT = math.clamp((gLow + gTop) * 0.5, 0.44, 0.78)
                    wantHold = tension < (targetT - 0.004)
                end
                setVirtualSpaceHeld(wantHold)
            elseif now >= OutdoorsState.fishNextPulseAt then
                local nextHold = not OutdoorsState.fishSpaceHeld
                setVirtualSpaceHeld(nextHold)
                OutdoorsState.fishNextPulseAt = now + (nextHold and 0.13 or 0.07)
            end
        end
    end
end

local function pickBestGemNode(hrpPos, now)
    local nodes = getMineGemNodes()
    local mode = State.MinePriority or "Largest First"
    local reachLimit = (MineConfig and MineConfig.REACH or 11) - 0.5
    local best, bestScore = nil, math.huge

    for _, n in ipairs(nodes) do
        if now >= (Cooldowns.mineSkip[n.id] or 0) then
            local dist = (n.pos - hrpPos).Magnitude
            if State.MineWalkToNodes or dist <= reachLimit then
                local score = dist
                if State.MineAsteroid and n.isAsteroid then
                    score = score - 50000
                elseif mode == "Largest First" then
                    score = dist - n.rank * 400
                elseif mode == "Smallest First" then
                    score = dist + n.rank * 400
                end
                if score < bestScore then
                    bestScore = score
                    n.dist = dist
                    best = n
                end
            end
        end
    end
    return best
end

local function stopHuntKiting(hum, hrpPos)
    if not OutdoorsState.kiting then return end
    OutdoorsState.kiting = false
    OutdoorsState.kiteCheckAt = 0
    OutdoorsState.kiteCheckPos = nil
    if hum and hum.Health > 0 and hrpPos and not ActivePath.walking then
        pcall(function() hum:MoveTo(hrpPos) end)
    end
end

local function stepHuntKiting(now, hrpPos, hum, hrp, threats)
    if not State.HuntWalkToTarget or ActivePath.walking or not threats or #threats == 0 then
        stopHuntKiting(hum, hrpPos)
        return false
    end

    if not OutdoorsState.kiting or now >= (OutdoorsState.kiteCheckAt or 0) then
        if OutdoorsState.kiting and OutdoorsState.kiteCheckPos and (hrpPos - OutdoorsState.kiteCheckPos).Magnitude < 1.2 then
            OutdoorsState.kiteSide = -OutdoorsState.kiteSide
        end
        OutdoorsState.kiteCheckAt = now + 0.45
        OutdoorsState.kiteCheckPos = hrpPos
    end

    local weightedThreat = Vector3.zero
    local totalWeight = 0
    local nearestDist = math.huge
    for _, t in ipairs(threats) do
        local d = math.max(t.dist, 1)
        if d < nearestDist then nearestDist = d end
        local w = 1 / (d * d)
        weightedThreat = weightedThreat + t.pos * w
        totalWeight = totalWeight + w
    end
    if totalWeight <= 0 or nearestDist > 48 then
        stopHuntKiting(hum, hrpPos)
        return false
    end

    local threatCenter = weightedThreat / totalWeight
    local flatAway = Vector3.new(hrpPos.X - threatCenter.X, 0, hrpPos.Z - threatCenter.Z)
    local baseDir = flatAway.Magnitude > 0.1 and flatAway.Unit or Vector3.new(0, 0, 1)
    local s = OutdoorsState.kiteSide or 1
    local anglesDeg = { 0, 40 * s, -40 * s, 80 * s, -80 * s, 125 * s, -125 * s }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    if LocalPlayer.Character then table.insert(exclude, LocalPlayer.Character) end
    local wsWildlife = Workspace:FindFirstChild("Wildlife")
    if wsWildlife then table.insert(exclude, wsWildlife) end
    local wsPrompts = Workspace:FindFirstChild("HuntPrompts")
    if wsPrompts then table.insert(exclude, wsPrompts) end
    rayParams.FilterDescendantsInstances = exclude

    local bestDest = nil
    local baseAngle = math.atan2(baseDir.Z, baseDir.X)
    local waterReach = (FishingConfig and FishingConfig.REACH) or 30
    for _, degOffset in ipairs(anglesDeg) do
        local rad = baseAngle + math.rad(degOffset)
        local dir = Vector3.new(math.cos(rad), 0, math.sin(rad))
        local cand = hrpPos + dir * 18
        local inWater = FishingConfig and type(FishingConfig.distanceToWater) == "function"
            and FishingConfig.distanceToWater(cand.X, cand.Z) <= (waterReach + 6)
        if not inWater then
            local gy = resolveWorldGroundY(cand.X, cand.Z, hrpPos.Y, false, false, true)
            if gy and math.abs(gy - hrpPos.Y) <= 12 then
                local hit = Workspace:Raycast(hrpPos + Vector3.new(0, 2.2, 0), dir * 13, rayParams)
                if not hit or not hit.Instance or hit.Instance.CanCollide == false then
                    bestDest = Vector3.new(cand.X, gy, cand.Z)
                    break
                end
            end
        end
    end

    if not bestDest then
        local rad = baseAngle + math.rad(45 * s)
        local dir = Vector3.new(math.cos(rad), 0, math.sin(rad))
        local cand = hrpPos + dir * 14
        local gy = resolveWorldGroundY(cand.X, cand.Z, hrpPos.Y, false, false, true) or hrpPos.Y
        bestDest = Vector3.new(cand.X, gy, cand.Z)
    end

    OutdoorsState.kiting = true
    pcall(function() hum:MoveTo(bestDest) end)
    return true
end

