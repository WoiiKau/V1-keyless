    for _, model in ipairs(props:GetChildren()) do
        if model:IsA("Model") then
            local def = model:GetAttribute("Def")
            local info = type(def) == "string" and Furniture and Furniture[def] or nil
            local isCookProp = false
            if info then
                if type(info.station) == "string" then
                    stations[info.station] = true
                    if COOK_STATIONS[info.station] then
                        isCookProp = true
                    end
                end
