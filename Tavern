        if isDirtyItem(item) then
            dirtyCount = dirtyCount + 1
        end
    end
    return {
        total = #list,
        counts = counts,
        dirtyCount = dirtyCount,
    }
end

local function getMyBarSlots(cur)
    local slots = {}
    local bars = cur and cur.tavern and cur.tavern.bars
    if type(bars) ~= "table" then return slots end

    local freeDrink = (Drinks and Drinks.FREE) or "Water"
    for barUid, barSlots in pairs(bars) do
        if type(barSlots) == "table" then
            for slotKey, slotData in pairs(barSlots) do
                local slotNum = tonumber(slotKey)
                if slotNum and type(slotData) == "table" and type(slotData.drink) == "string" and slotData.drink ~= "" then
                    local isFree = (slotData.drink == freeDrink)
                    local amt = tonumber(slotData.amount) or 0
                    table.insert(slots, {
                        barUid = barUid,
                        slot = slotNum,
                        drink = slotData.drink,
                        amount = amt,
                        isFree = isFree,
                        canPour = isFree or amt > 0,
                    })
                end
            end
        end
    end

    table.sort(slots, function(a, b)
        if a.barUid ~= b.barUid then
            return tostring(a.barUid) < tostring(b.barUid)
        end
        return a.slot < b.slot
    end)

    return slots
end

