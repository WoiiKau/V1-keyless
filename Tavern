                BackgroundTransparency = 1,

                Text = label,

                TextColor3 = C.text,

                TextSize = 10,

                Font = Enum.Font.MontserratBold,

                TextXAlignment = Enum.TextXAlignment.Left,

            }, card)



            local valLbl = make("TextLabel", {

                Size = UDim2.new(0.3, 0, 0, 20),

                Position = UDim2.new(0.7, -12, 0, 4),

                BackgroundTransparency = 1,

                Text = tostring(initVal),

                TextColor3 = C.accent,

                TextSize = 10,

                Font = Enum.Font.MontserratBold,

                TextXAlignment = Enum.TextXAlignment.Right,

            }, card)



            local sliderTrack = make("Frame", {

                Size = UDim2.new(1, -24, 0, 8),

                Position = UDim2.new(0, 12, 0.7, -4),

                BackgroundColor3 = COLORS.BG,

                BorderSizePixel = 0,

            }, card)

            corner(4, sliderTrack)



            local currentRatio = math.clamp((initVal - minVal) / (maxVal - minVal), 0, 1)

            local sliderFill = make("Frame", {

                Size = UDim2.fromScale(currentRatio, 1),

                BackgroundColor3 = C.accent,

                BorderSizePixel = 0,

            }, sliderTrack)

            corner(4, sliderFill)



            local sliderBtn = make("ImageButton", {

                Size = UDim2.fromOffset(20, 20),

                AnchorPoint = Vector2.new(0.5, 0.5),

                Position = UDim2.fromScale(currentRatio, 0.5),

                BackgroundColor3 = C.text,

                BorderSizePixel = 0,

                AutoButtonColor = false,

                ZIndex = 5,

            }, sliderTrack)

            corner(10, sliderBtn)



            local dragging = false

            local function applyAt(ratio)

                local exact = minVal + ratio * (maxVal - minVal)

                local stepped = math.floor((exact / step) + 0.5) * step

                stepped = math.clamp(stepped, minVal, maxVal)

                valLbl.Text = tostring(stepped)

                local r = math.clamp((stepped - minVal) / (maxVal - minVal), 0, 1)

                sliderFill.Size = UDim2.fromScale(r, 1)

                sliderBtn.Position = UDim2.fromScale(r, 0.5)

                NexUI.Config[flag] = stepped

                if onChange then pcall(onChange, stepped) end

            end



            local function startDrag(inp)

                if isTouchOrClick(inp) then

                    dragging = true

                    applyAt(math.clamp((inp.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1))

                end

            end



            table.insert(cleanUpSignals, sliderTrack.InputBegan:Connect(startDrag))

            table.insert(cleanUpSignals, sliderBtn.InputBegan:Connect(startDrag))

            table.insert(cleanUpSignals, card.InputBegan:Connect(function(inp)

                if isTouchOrClick(inp) then

                    local relY = inp.Position.Y - card.AbsolutePosition.Y

                    if relY > 20 then

                        startDrag(inp)

                    end

                end

            end))

            table.insert(cleanUpSignals, UserInputService.InputChanged:Connect(function(inp)

                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then

                    applyAt(math.clamp((inp.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1))

                end

            end))

            table.insert(cleanUpSignals, UserInputService.InputEnded:Connect(function(inp)

                if isTouchOrClick(inp) and dragging then

                    dragging = false

                    saveConfig()

                end

            end))



            local function updateSlider(newVal)

                newVal = tonumber(newVal) or initVal

                newVal = math.clamp(newVal, minVal, maxVal)

                local r = math.clamp((newVal - minVal) / (maxVal - minVal), 0, 1)

                valLbl.Text = tostring(newVal)

                sliderFill.Size = UDim2.fromScale(r, 1)

                sliderBtn.Position = UDim2.fromScale(r, 0.5)

            end



            NexUI.FlagUpdaters[flag] = updateSlider

            NexUI.FlagCallbacks[flag] = onChange



            return card, updateSlider

        end



