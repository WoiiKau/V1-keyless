local function isWithinReach(hrpPos, targetPos, maxReach)
    if not hrpPos or not targetPos then return false end
    local reach = maxReach or State.MaxReach
    return horizontalDist(hrpPos, targetPos) <= reach
        and (hrpPos - targetPos).Magnitude <= (reach + 1.2)
        and math.abs(hrpPos.Y - targetPos.Y) <= 6.0
end

