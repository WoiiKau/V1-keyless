local getTroublemakers
do
local function parsePromptAttribute(promptStr)
    if type(promptStr) ~= "string" or promptStr == "" then return nil end
    local parts = string.split(promptStr, "|")
    local actionId = parts[1]
    if not actionId or actionId == "" then return nil end
    return {
        actionId = actionId,
        actionText = parts[2] or "",
        objectText = parts[3] or "",
        holdDuration = tonumber(parts[4]) or 0,
        maxDist = tonumber(parts[5]) or 10,
        allowedOwner = tonumber(parts[6]),
    }
end

local function isTroublemakerPrompt(entry, parsed)
    local kindLower = tostring(entry.kind or ""):lower()
    local actLower = parsed.actionId:lower()
    local textLower = parsed.actionText:lower()
    local objLower = parsed.objectText:lower()

    return textLower:find("kick", 1, true) ~= nil
        or actLower:find("kick", 1, true) ~= nil
        or textLower:find("break", 1, true) ~= nil
        or actLower:find("break", 1, true) ~= nil
        or actLower:find("scuffle", 1, true) ~= nil
        or objLower:find("thief", 1, true) ~= nil
        or objLower:find("bard", 1, true) ~= nil
        or objLower:find("witch", 1, true) ~= nil
        or kindLower:find("thief", 1, true) ~= nil
        or kindLower:find("bard", 1, true) ~= nil
        or kindLower:find("witch", 1, true) ~= nil
        or kindLower:find("trouble", 1, true) ~= nil
end

getTroublemakers = function(ownerId)
    local found = {}
    if not ActorController or not ActorController.list then return found end

    local ok, list = pcall(ActorController.list)
    if not ok or type(list) ~= "table" then return found end

    local plot = findPlotForOwner(ownerId)
    local hrp = getPlayerRoot()
    local hrpPos = hrp and hrp.Position
    local now = os.clock()

    for _, entry in ipairs(list) do
        if entry.inst then
            local parsed = parsePromptAttribute(entry.inst:GetAttribute("Prompt"))
            if parsed then
                local allowed = (parsed.allowedOwner and parsed.allowedOwner == ownerId)
                    or (parsed.allowedOwner == nil and (entry.owner == ownerId or ownerOfInstance(entry.inst) == ownerId))
                if allowed and isTroublemakerPrompt(entry, parsed) then
                    local body = ActorController.body and ActorController.body(entry.id)
                    local piv = body and body:GetPivot()
                    local pos = (piv and piv.Position) or entry.pos
                    local standPos = piv and computeClearStandPos(plot, pos, piv, 2.2, body, hrpPos)
                        or (pos and Vector3.new(pos.X, getFloorYForPlot(plot, pos, pos.Y), pos.Z))
                    local label = parsed.objectText ~= "" and parsed.objectText
                        or (parsed.actionText ~= "" and parsed.actionText)
                        or tostring(entry.kind or "Troublemaker")
                    local reach = math.min(State.MaxReach, math.max(4.0, parsed.maxDist - 1.5))
                    local dist = (hrpPos and pos) and horizontalDist(hrpPos, pos) or math.huge

                    table.insert(found, {
                        id = entry.id,
                        actionId = parsed.actionId,
                        label = label,
                        body = body,
                        pos = pos,
                        standPos = standPos,
                        reach = reach,
                        dist = dist,
                        score = hrpPos and scoreTargetForPlayer(plot, hrpPos, pos, standPos, "actor:" .. tostring(entry.id), now) or dist,
                    })
                end
            end
        end
    end

    table.sort(found, function(a, b)
        return a.score < b.score
    end)

    return found
end
end

