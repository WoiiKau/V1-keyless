    "Bear",
    "Wolf",
    "Stag",
    "Doe",
    "Boar",
    "Fox",
    "Raccoon",
    "Rabbit",
}

local HUNT_VALUE_RANK = {
    Bear = 8,
    Wolf = 7,
    Stag = 6,
    Doe = 5,
    Boar = 4,
    Fox = 3,
    Raccoon = 2,
    Rabbit = 1,
