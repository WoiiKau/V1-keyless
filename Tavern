-- ============================================================================
trackConn(RunService.Heartbeat:Connect(function()
    if not Running then return end
    local now = os.clock()
    local hrp, hum = getPlayerRoot()

    if TravelState.active and TravelState.mode == "Auto Walk" and hum then
        if not EventState.origWalkSpeed then
            EventState.origWalkSpeed = hum.WalkSpeed
        end
        hum.WalkSpeed = State.EnableWalkSpeed and math.min(State.WalkSpeed, 31) or 31
    elseif State.EnableWalkSpeed and hum then
        if not EventState.origWalkSpeed then
            EventState.origWalkSpeed = hum.WalkSpeed
        end
        hum.WalkSpeed = ActivePath.walking and math.min(State.WalkSpeed, 30) or State.WalkSpeed
    end

    if (State.AlertWorldEvents or State.EspGemNodes or State.EspWildlife or State.EspTroublemakers or next(EspCache) ~= nil) and now >= Cooldowns.nextEsp then
        Cooldowns.nextEsp = now + 0.35
        if State.AlertWorldEvents then
            pcall(syncWorldEventAlerts)
        end
        pcall(updateEspVisuals)
    end

    pcall(stepTravel, now)
    if TravelState.active then
        if ActivePath.walking then
            stopAutoWalk(hum, hrp)
        end
        return
    end

    if State.AutoFish then
        pcall(stepFishingMinigame, now)
    elseif OutdoorsState.fishSpaceHeld then
        setVirtualSpaceHeld(false)
    end

    local hasBarWork = (
        hasBarMovementWork()
        or State.KeepTavernOpen
        or State.AlertTroublemakers
    )
    local hasOutdoorsWork = (
        State.AutoHunt
        or State.AutoCollectKills
        or State.AutoFish
        or State.AutoMine
    )

    if not hasBarWork and not hasOutdoorsWork then
        if ActivePath.walking then
            stopAutoWalk(hum, hrp)
        end
        return
    end

    if ActivePath.walking then
        pcall(stepAutoWalk, now)
    end

    if hasOutdoorsWork and now >= Cooldowns.nextOutdoorsTick then
        local outdoorsDelay = ActivePath.walking and 0.14 or 0.22
        if State.AutoHunt and State.HuntFastBow and (OutdoorsState.drawing or (now + 0.22 >= OutdoorsState.nextShotAt)) then
            outdoorsDelay = 0.04
        end
        Cooldowns.nextOutdoorsTick = now + outdoorsDelay
        pcall(runOutdoorsStep, now)
    end

    if hasBarWork and now >= Cooldowns.nextTick then
        Cooldowns.nextTick = now + (ActivePath.walking and 0.14 or math.max(0.15, State.ServeInterval))
        local okBar, errBar = pcall(runBarStep, now)
        if not okBar then
            warn("[NexWorks] runBarStep error:", errBar)
        end
    end
end))

trackConn(RunService.Stepped:Connect(function()
    if not Running then return end
    local now = os.clock()
    pcall(syncPropCollision, now)
    local needsNoclip = State.Noclip or (TravelState.active and (TravelState.mode == "Safe Glide" or now < TravelState.noclipGraceUntil))
    if not needsNoclip then
        if next(NoclipSavedParts) ~= nil then
            restoreCollision()
        end
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    if TravelState.active and TravelState.mode == "Safe Glide" then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if NoclipSavedParts[part] == nil then
                NoclipSavedParts[part] = part.CanCollide
            end
            if part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end))

trackConn(UserInputService.JumpRequest:Connect(function()
    if not Running or not State.InfiniteJump then return end
    local _, hum = getPlayerRoot()
