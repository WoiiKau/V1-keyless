        local origPlay = CookingModule.play
        local hookInstalled = false

        restoreCookingHook = function()
            if not hookInstalled or not CookingModule then return end
            hookInstalled = false
            pcall(function()
                if setreadonly then pcall(setreadonly, CookingModule, false) end
                CookingModule.play = origPlay
                if setreadonly then pcall(setreadonly, CookingModule, true) end
            end)
        end

        local okHook = pcall(function()
            if setreadonly then pcall(setreadonly, CookingModule, false) end
            CookingModule.play = function(dish, owner, finishCb, closeCb, stepCb)
                if not Running or not (State.AutoCook or State.AutoCookPrep) then
                    return origPlay(dish, owner, finishCb, closeCb, stepCb)
                end

                local steps = Food and Food.steps and Food.steps(dish) or {}
                local nSteps = math.max(2, #steps)
                local handMin = (Food and Food.handMin and Food.handMin(dish)) or 1.0
                local needSec = math.max(handMin + 0.35, 1.25)

                KitchenState.cooking = true
                KitchenState.awaitingStartUntil = 0
                KitchenState.activeDish = dish
                KitchenState.cookingUntil = os.clock() + needSec + 4.0

                task.spawn(function()
                    local t0 = os.clock()
                    -- Step spacing > 0.3s satisfies KitchenController's CookStep throttle
                    for i = 0, nSteps do
                        if not Running then break end
                        if stepCb then pcall(stepCb, i, nSteps) end
                        if i < nSteps then
                            task.wait(0.36)
                        end
                    end

                    while Running and (os.clock() - t0) < needSec do
                        task.wait(0.05)
                    end

                    if not Running then
                        if finishCb then pcall(finishCb, -1) end
                        if closeCb then pcall(closeCb) end
                        KitchenState.cooking = false
                        KitchenState.cookingUntil = 0
                        return
                    end

                    local quality = State.AutoCookPerfect and 1.0 or 0.75
                    if finishCb then pcall(finishCb, quality) end
                    Cooldowns.nextCookStart = math.max(Cooldowns.nextCookStart, os.clock() + 0.55)
                    task.wait(0.22)
                    if closeCb then pcall(closeCb) end
                    KitchenState.cooking = false
                    KitchenState.cookingUntil = 0
                end)
            end
            if setreadonly then pcall(setreadonly, CookingModule, true) end
        end)

        hookInstalled = okHook
    end
end)

local function isGuestDeliverableForModes(guest)
    if not guest then return false end
    if guest.isFood then
        return State.AutoBarServe or State.AutoCookDeliver
    end
    return State.AutoBarServe
end

local function findModeDeliverableGuest(guests, trayCounts, hrpPos, now)
    local tNow = now or os.clock()
    for _, guest in ipairs(guests) do
        local gid = tostring(guest.guestId)
        if isGuestDeliverableForModes(guest)
            and (trayCounts[guest.order] or 0) > 0
            and isActionableTarget(hrpPos, guest.pos)
            and not isActionSkipped("deliver:" .. gid, tNow)
            and not isMoveBlocked("guest:" .. gid, tNow) then
            return guest
        end
    end
    return nil
end

local function canCookDish(cur, plotKitchen, dish)
    if not dish or not Food or not Food.Dishes or not Food.Dishes[dish] then
        return false, 0
    end
    if SkillsConfig and SkillsConfig.dishUnlocked and not SkillsConfig.dishUnlocked(cur.skills, dish) then
        return false, 0
    end
    for _, st in ipairs(Food.stations(dish)) do
        if not plotKitchen.stations[st] then
            return false, 0
        end
    end
    local baseIng = Food.ingredients(dish)
    local cost = cur.lessonFree and 0 or (Perks and Perks.cost and Perks.cost(cur.skills, baseIng) or baseIng)
    local gold = cur.gold or 0
    if gold < cost or (gold - cost) < (State.AutoCookMinGold or 0) then
        return false, cost
    end
    return true, cost
end

local function findNextCookCandidate(myOwner, cur, plotKitchen, guests, trayCounts, hrpPos, now, staffCounts)
    if not plotKitchen or not plotKitchen.target then return nil end
    if not isActionableTarget(hrpPos, plotKitchen.target.pos) then return nil end
    local kitchenMoveKey = "kitchen:" .. tostring(plotKitchen.target.key or myOwner)
    if isMoveBlocked(kitchenMoveKey, now) then return nil end

    local held = parseKitchenHeld(plotKitchen.plot)
    local counter = getCounterState(myOwner)
    local activeStaff = staffCounts or getStaffCarriedCounts(myOwner)
    local heldWayByOrder = {}
    local foodGuests = {}
    for _, guest in ipairs(guests) do
        if guest.isFood then
            if held[guest.guestId] == "way" then
                heldWayByOrder[guest.order] = (heldWayByOrder[guest.order] or 0) + 1
            end
            table.insert(foodGuests, guest)
        end
    end

    -- Serve longest-waiting guests first (smaller guestId) so orders don't time out
    table.sort(foodGuests, function(a, b)
        return (a.guestId or 0) < (b.guestId or 0)
    end)

    local spareInHand = {}
    for _, guest in ipairs(foodGuests) do
        local gid = guest.guestId
        if not held[gid] and not counter.byGuest[gid] and now >= (Cooldowns.cookGuest[gid] or 0) then
            local orderKey = guest.order
            if spareInHand[orderKey] == nil then
                spareInHand[orderKey] = math.max(0, (trayCounts[orderKey] or 0) + (activeStaff[orderKey] or 0) - (heldWayByOrder[orderKey] or 0))
            end
            if spareInHand[orderKey] > 0 then
                spareInHand[orderKey] = spareInHand[orderKey] - 1
            else
                local dish = Food and Food.dishOf and Food.dishOf(orderKey)
                local ok = canCookDish(cur, plotKitchen, dish)
                if ok then
                    return {
                        kind = "guest",
                        guestId = gid,
                        dish = dish,
                        target = plotKitchen.target,
                    }
                end
            end
        end
    end

    return nil
end

local function findNextPrepCandidate(myOwner, cur, plotKitchen, hrpPos, now)
    if not plotKitchen or not plotKitchen.target or (plotKitchen.counterSlots or 0) <= 0 then
        return nil
    end
    local tNow = now or os.clock()
    if not isActionableTarget(hrpPos, plotKitchen.target.pos) then
        return nil
    end
    if isMoveBlocked("kitchen:" .. tostring(plotKitchen.target.key or myOwner), tNow) then
        return nil
    end
    local counter = getCounterState(myOwner)
    if counter.count >= plotKitchen.counterSlots then
        return nil
    end

    local menu = cur.tavern and cur.tavern.menu or {}
    local dishPrices = cur.tavern and cur.tavern.dishPrices or {}
    local bestDish = nil
    local bestPrepped = math.huge
    local bestPrice = -1
    for dish, enabled in pairs(menu) do
        if enabled == true and tNow >= (Cooldowns.cookPrep[dish] or 0) and canCookDish(cur, plotKitchen, dish) then
            local prepped = counter.byDish[dish] or 0
            local price = Food.price(dish, dishPrices[dish])
            if prepped < bestPrepped or (prepped == bestPrepped and price > bestPrice) then
                bestPrepped = prepped
                bestPrice = price
                bestDish = dish
            end
        end
    end

    if bestDish then
        return {
            kind = "prep",
            dish = bestDish,
            target = plotKitchen.target,
        }
    end
    return nil
end

local function getOldestUnservedDrinkGuestId(guests, hrpPos, trayCounts, staffCounts)
    local drinkGuests = {}
    for _, guest in ipairs(guests) do
        if not guest.isFood and isActionableTarget(hrpPos, guest.pos) then
            table.insert(drinkGuests, guest)
        end
    end
    table.sort(drinkGuests, function(a, b)
        return (a.guestId or 0) < (b.guestId or 0)
    end)

    local matchedCounts = {}
    for _, guest in ipairs(drinkGuests) do
        local orderKey = guest.order
        local supply = (trayCounts[orderKey] or 0) + (staffCounts and staffCounts[orderKey] or 0)
        local avail = supply - (matchedCounts[orderKey] or 0)
        if avail > 0 then
            matchedCounts[orderKey] = (matchedCounts[orderKey] or 0) + 1
        else
            return guest.guestId
        end
    end
    return nil
end

local function executeCookStart(candidate, myOwner, kitchenRemote, now)
    if not candidate or not kitchenRemote or now < Cooldowns.nextCookStart then
        return false
    end
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui and playerGui:FindFirstChild("Cooking") then
        return false
    end
    local moveKey = "kitchen:" .. tostring(candidate.target.key or myOwner)
    if not ensureWithinRange(moveKey, candidate.target.pos, candidate.target.standPos, now) then
        return true
    end
    Cooldowns.nextCookStart = now + 0.9
    KitchenState.awaitingStartUntil = now + 2.2
    KitchenState.activeKind = candidate.kind
    KitchenState.activeGuestId = candidate.guestId
    KitchenState.activeDish = candidate.dish
    if candidate.kind == "guest" then
        Cooldowns.cookGuest[candidate.guestId] = now + 4.5
        kitchenRemote:FireServer("CookStart", { guest = candidate.guestId, owner = myOwner })
    else
        kitchenRemote:FireServer("CookStart", { prep = candidate.dish, owner = myOwner })
    end
    return true
end

-- ============================================================================
-- BAR & TAVERN AUTOMATION STEP ENGINE
-- ============================================================================
local BarBatchState = {
    delivering = false,
    washing = false,
}

local function getWantedGuestOrders(guests, hrpPos, staffCounts)
    local wantedDrinks = {}
    local wantedFoods = {}
    for _, guest in ipairs(guests) do
        if isActionableTarget(hrpPos, guest.pos) then
            if guest.isDrink then
                wantedDrinks[guest.order] = (wantedDrinks[guest.order] or 0) + 1
            elseif guest.isFood then
                wantedFoods[guest.order] = (wantedFoods[guest.order] or 0) + 1
            end
        end
    end
    if staffCounts then
        for orderKey, count in pairs(staffCounts) do
            if wantedDrinks[orderKey] then
                local rem = wantedDrinks[orderKey] - count
                wantedDrinks[orderKey] = rem > 0 and rem or nil
            elseif wantedFoods[orderKey] then
                local rem = wantedFoods[orderKey] - count
                wantedFoods[orderKey] = rem > 0 and rem or nil
            end
        end
    end
    return wantedDrinks, wantedFoods
end

local function getCounterDishPickups(ownerId, plot, hrpPos, wantedFoods, trayCounts, now)
    local kitchens = Workspace:FindFirstChild("Kitchens")
    if not kitchens then return {} end

    local tNow = now or os.clock()
    local groupsByKey = {}
    local groups = {}
    for _, child in ipairs(kitchens:GetChildren()) do
        if child:GetAttribute("Owner") == ownerId and child:GetAttribute("Counter") == true then
            local counterId = child:GetAttribute("CounterId")
            local dish = child:GetAttribute("Dish")
            if type(counterId) == "string" and type(dish) == "string" then
                local orderKey = (Food and Food.entry and Food.entry(dish)) or ("Food:" .. dish)
                local needQty = (wantedFoods[orderKey] or 0) - (trayCounts[orderKey] or 0)
                if needQty > 0 then
                    local guestAttr = child:GetAttribute("Guest")
                    local prepped = type(guestAttr) ~= "number" or guestAttr == 0
                    local gKey = counterId .. "|" .. dish .. "|" .. (prepped and "1" or "0")
                    if not isActionSkipped("counter:" .. gKey, tNow) and not isMoveBlocked("counter:" .. counterId, tNow) then
                        local piv = child:GetPivot()
                        local pos = piv and piv.Position
                        if pos and isActionableTarget(hrpPos, pos) then
                            local grp = groupsByKey[gKey]
                            if not grp then
                                local standPos = computeClearStandPos(plot, pos, piv, 2.5, child, hrpPos)
                                local dist = hrpPos and horizontalDist(hrpPos, pos) or math.huge
                                grp = {
                                    gKey = gKey,
                                    counter = counterId,
                                    dish = dish,
                                    orderKey = orderKey,
                                    prepped = prepped,
                                    count = 0,
                                    needQty = needQty,
                                    pos = pos,
                                    standPos = standPos,
                                    dist = dist,
                                    score = hrpPos and scoreTargetForPlayer(plot, hrpPos, pos, standPos, "counter:" .. counterId, tNow) or dist,
                                }
                                groupsByKey[gKey] = grp
                                table.insert(groups, grp)
                            end
                            grp.count = grp.count + 1
                        end
                    end
                end
            end
        end
    end

    table.sort(groups, function(a, b)
        if a.prepped ~= b.prepped then
            return not a.prepped
        end
        return a.score < b.score
    end)
    return groups
end

local function findNextBarPickup(ownerId, cur, plot, wantedDrinks, wantedFoods, trayInfo, maxCarry, hrpPos, kitchenRemote, now)
    local freeSlots = math.max(0, maxCarry - trayInfo.total)
    if freeSlots <= 0 then return nil end

    local tNow = now or os.clock()
    local best = nil
    local function consider(candidate)
        if not best or (candidate.score or candidate.dist) < (best.score or best.dist) then
            best = candidate
        end
    end

    if kitchenRemote and next(wantedFoods) ~= nil then
        local foodPickups = getCounterDishPickups(ownerId, plot, hrpPos, wantedFoods, trayInfo.counts, tNow)
        local topFood = foodPickups[1]
        if topFood then
            consider({
                kind = "takeDish",
                group = topFood,
                takeCount = math.min(topFood.count, topFood.needQty, freeSlots),
                pos = topFood.pos,
                standPos = topFood.standPos,
                dist = topFood.dist,
                score = topFood.score,
            })
        end
    end

    local slots = getMyBarSlots(cur)
    for _, slot in ipairs(slots) do
        local wantQty = wantedDrinks[slot.drink] or 0
        local haveQty = trayInfo.counts[slot.drink] or 0
        local pourKey = "pour:" .. tostring(slot.barUid) .. ":" .. tostring(slot.slot)
        local barMoveKey = "bar:" .. tostring(slot.barUid)
        if wantQty > haveQty and slot.canPour and not isActionSkipped(pourKey, tNow) and not isMoveBlocked(barMoveKey, tNow) then
            local barTarget = findBarTarget(ownerId, slot.barUid, hrpPos)
            if not barTarget or isActionableTarget(hrpPos, barTarget.pos) then
                local pos = barTarget and barTarget.pos
                local standPos = barTarget and barTarget.standPos
                local dist = (hrpPos and pos) and horizontalDist(hrpPos, pos) or 0
                local score = (hrpPos and pos) and scoreTargetForPlayer(plot, hrpPos, pos, standPos, barMoveKey, tNow) or dist
                consider({
                    kind = "pour",
                    slot = slot,
                    barTarget = barTarget,
                    pos = pos,
                    standPos = standPos,
                    dist = dist,
                    score = score,
                })
            end
        end
    end

    return best
end

local function executePickupAction(pickup, myOwner, kitchenRemote, serveRemote, trayInfo, now)
    if pickup.kind == "takeDish" then
        if now < Cooldowns.nextTakeDish then
            return
        end
        if not ensureWithinRange("counter:" .. pickup.group.counter, pickup.pos, pickup.standPos, now) then
            return
        end
        Cooldowns.nextTakeDish = now + 0.35
        noteActionAttempt("counter:" .. pickup.group.gKey, tostring(pickup.group.count) .. ":" .. tostring(trayInfo and trayInfo.total or 0), now, 2, 5.0)
        kitchenRemote:FireServer("TakeDish", {
            counter = pickup.group.counter,
            dish = pickup.group.dish,
            prepped = pickup.group.prepped,
            count = pickup.takeCount,
            owner = myOwner,
        })
        return
    end

    if now < Cooldowns.nextPour then
        return
    end
    local barTarget = pickup.barTarget
    if barTarget and not ensureWithinRange("bar:" .. tostring(pickup.slot.barUid), barTarget.pos, barTarget.standPos, now) then
        return
    end
    Cooldowns.nextPour = now + math.max(0.25, State.ServeInterval)
    local haveQty = trayInfo and trayInfo.counts and trayInfo.counts[pickup.slot.drink] or 0
    noteActionAttempt("pour:" .. tostring(pickup.slot.barUid) .. ":" .. tostring(pickup.slot.slot), tostring(pickup.slot.amount) .. ":" .. tostring(haveQty), now, 2, 4.5)
    serveRemote:FireServer("Pour", {
        owner = myOwner,
        bar = pickup.slot.barUid,
        slot = pickup.slot.slot,
    })
end

local function inspectDirtySeats(myOwner, hrpPos, now)
    local dirtySeats = getDirtySeats(myOwner)
    local justClearedWaiting = false
    for _, seatInfo in ipairs(dirtySeats) do
        if isActionableTarget(hrpPos, seatInfo.pos)
            and not isActionSkipped("clear:" .. seatInfo.key, now)
            and not isMoveBlocked("clear:" .. seatInfo.key, now) then
            local readyAt = Cooldowns.clear[seatInfo.key] or 0
            if now >= readyAt then
                return seatInfo, false
            end
            -- Brief replication grace after Clear so 1-mug waves do not linger forever on stale failure
            if (readyAt - now) > 0.65 then
                justClearedWaiting = true
            end
        end
    end
    return nil, justClearedWaiting
end

local function tryWashDirtyTray(myOwner, hrpPos, serveRemote, now)
    local basinTarget = findBasinTarget(myOwner, hrpPos)
    local basinMoveKey = basinTarget and ("basin:" .. tostring(basinTarget.key)) or ("basin:" .. tostring(myOwner))
    if not basinTarget or not isActionableTarget(hrpPos, basinTarget.pos) or isMoveBlocked(basinMoveKey, now) then
        return false
    end
    BarBatchState.washing = true
    if now < Cooldowns.nextWash then
        return true
    end
    if not ensureWithinRange(basinMoveKey, basinTarget.pos, basinTarget.standPos, now) then
        return true
    end
    Cooldowns.nextWash = now + 0.65
    serveRemote:FireServer("WashUp", { owner = myOwner })
    return true
end

local function clearDirtySeat(seatInfo, trayTotal, now)
    if not ensureWithinRange("clear:" .. seatInfo.key, seatInfo.pos, seatInfo.standPos, now) then
        return
    end
    local serveRemote = getRemote("Serve")
    if not serveRemote then return end
    Cooldowns.clear[seatInfo.key] = now + 1.0
    noteActionAttempt("clear:" .. seatInfo.key, tostring(seatInfo.mugCount or 1) .. ":" .. tostring(trayTotal or 0), now, 2, 6.0)
    serveRemote:FireServer("Clear", {
        owner = seatInfo.owner,
        seat = seatInfo.seat,
    })
end

local function runBarStep(now)
    local cur = getCurrentState()
    if not cur or cur.building then return end

    local myOwner = LocalPlayer.UserId
    local hrp = getPlayerRoot()
    local hrpPos = hrp and hrp.Position

    local serveRemote = getRemote("Serve")
    local kitchenRemote = getRemote("Kitchen")

    -- Optional: Keep Tavern Open
    if State.KeepTavernOpen and cur.open == false and serveRemote and now >= Cooldowns.nextOpen then
        Cooldowns.nextOpen = now + 2.0
        serveRemote:FireServer("SetOpen", { open = true })
        return
    end

    -- 0. Tavern Security: Alerts work from anywhere; physical bar/security waits until near own plot
    local troublemakers = nil
    if State.AutoKickTroublemakers or State.AlertTroublemakers then
        troublemakers = getTroublemakers(myOwner)
        syncTroublemakerAlerts(troublemakers)
    end

    if State.AutoMine or State.AutoFish or State.AutoHunt then
        return
    end

    local myPlot = findPlotForOwner(myOwner)
    if myPlot and hrpPos and horizontalDist(hrpPos, myPlot:GetPivot().Position) > 160 then
        if ActivePath.walking then
            local _, hum = getPlayerRoot()
            stopAutoWalk(hum, hrp)
        end
        return
    end

    if State.AutoKickTroublemakers and troublemakers then
        local actorRemote = getRemote("ActorPrompt")
        if actorRemote then
            for _, t in ipairs(troublemakers) do
                local tid = tostring(t.id)
                if now >= (Cooldowns.actorPrompt[t.id] or 0)
                    and isActionableTarget(hrpPos, t.pos, t.reach)
                    and not isActionSkipped("kick:" .. tid, now)
                    and not isMoveBlocked("actor:" .. tid, now) then
                    if not ensureWithinRange("actor:" .. tid, t.pos, t.standPos, now, t.reach) then
                        return
                    end
                    Cooldowns.actorPrompt[t.id] = now + 0.85
                    noteActionAttempt("kick:" .. tid, t.actionId, now, 2, 6.0)
                    actorRemote:FireServer(t.id, t.actionId)
                    return
                end
            end
        end
    end

    if not serveRemote then return end
    if not (State.AutoBarServe or State.AutoClearWash or State.AutoRefillKegs or State.AutoCook or State.AutoCookDeliver or State.AutoCookPrep) then
        BarBatchState.delivering = false
        BarBatchState.washing = false
        return
    end

    local trayInfo = analyzeTray(cur.tray)
    local maxCarry = getMaxCarry(cur)
    local guests = getPendingGuests(myOwner)
    local firstModeDeliverable = findModeDeliverableGuest(guests, trayInfo.counts, hrpPos, now)

    if not State.AutoClearWash or trayInfo.dirtyCount == 0 then
        BarBatchState.washing = false
    end
    if not (State.AutoBarServe or State.AutoCookDeliver) or not firstModeDeliverable then
        BarBatchState.delivering = false
    end

    -- 1. Finish dirty mug/plate batch up to maxCarry before washing at nearest reachable basin
    if State.AutoClearWash and trayInfo.dirtyCount > 0 and not BarBatchState.delivering then
        if trayInfo.total < maxCarry and not BarBatchState.washing then
            local nextSeat, justClearedWaiting = inspectDirtySeats(myOwner, hrpPos, now)
            local nearBasin = findBasinTarget(myOwner, hrpPos)
            local basinRightHere = nearBasin and hrpPos
                and horizontalDist(hrpPos, nearBasin.pos) <= 7.5
                and math.abs(nearBasin.pos.Y - hrpPos.Y) <= 6.5
                and not isMoveBlocked("basin:" .. tostring(nearBasin.key), now)
            local seatTooFarFromSink = nextSeat and hrpPos
                and (horizontalDist(hrpPos, nextSeat.pos) > 18 or math.abs(nextSeat.pos.Y - hrpPos.Y) > 6.5)

            if nextSeat and not (basinRightHere and seatTooFarFromSink) then
                clearDirtySeat(nextSeat, trayInfo.total, now)
                return
            elseif justClearedWaiting and not basinRightHere then
                return
            end
        end
        if tryWashDirtyTray(myOwner, hrpPos, serveRemote, now) then
            return
        end
    end

    -- 2. Auto Refill low kegs nearest-first (yields cleanly on gold shortage or Barrel Filler claim)
    if State.AutoRefillKegs and not BarBatchState.delivering then
        local slots = getMyBarSlots(cur)
        local bestRefill, bestRefillScore = nil, math.huge
        for _, slot in ipairs(slots) do
            if not slot.isFree and slot.amount <= State.RefillThreshold then
                local rKey = tostring(slot.barUid) .. ":" .. tostring(slot.slot)
                local barMoveKey = "bar:" .. tostring(slot.barUid)
                if now >= (Cooldowns.refill[rKey] or 0)
                    and not isActionSkipped("refill:" .. rKey, now)
                    and not isMoveBlocked(barMoveKey, now) then
                    local barTarget = findBarTarget(myOwner, slot.barUid, hrpPos)
                    if not barTarget or isActionableTarget(hrpPos, barTarget.pos) then
                        local score = barTarget and scoreTargetForPlayer(myPlot, hrpPos, barTarget.pos, barTarget.standPos, barMoveKey, now) or 0
                        if score < bestRefillScore then
                            bestRefillScore = score
                            bestRefill = { slot = slot, rKey = rKey, barTarget = barTarget, barMoveKey = barMoveKey }
                        end
                    end
                end
            end
        end
        if bestRefill then
            local barTarget = bestRefill.barTarget
            if barTarget and not ensureWithinRange(bestRefill.barMoveKey, barTarget.pos, barTarget.standPos, now) then
                return
            end
            Cooldowns.refill[bestRefill.rKey] = now + 2.0
            noteActionAttempt("refill:" .. bestRefill.rKey, tostring(bestRefill.slot.amount), now, 2, 12.0)
            serveRemote:FireServer("Refill", {
                amount = "max",
                bar = bestRefill.slot.barUid,
                slot = bestRefill.slot.slot,
            })
            return
        end
    end

    -- Guard active cooking sequence before dispatching another walk/pour/cook/wash action
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui and playerGui:FindFirstChild("Cooking") then
        return
    end
    if KitchenState.cooking then
        if now >= KitchenState.cookingUntil then
            KitchenState.cooking = false
            KitchenState.cookingUntil = 0
        else
            return
        end
    elseif now < KitchenState.awaitingStartUntil then
        return
    end

    local staffCounts = getStaffCarriedCounts(myOwner)

    -- 3. Auto Serve & Auto Cook batch: fill drinks, ready counter food & cooked orders up to maxCarry before delivering
    if State.AutoBarServe or State.AutoCook or State.AutoCookDeliver then
        local modeDeliverable = findModeDeliverableGuest(guests, trayInfo.counts, hrpPos, now)
        if not modeDeliverable then
            BarBatchState.delivering = false
        end

        if not BarBatchState.delivering and trayInfo.total < maxCarry then
            local wantedDrinks, wantedFoods = getWantedGuestOrders(guests, hrpPos, staffCounts)
            local drinkWants = State.AutoBarServe and wantedDrinks or {}
            local foodWants = (State.AutoBarServe or State.AutoCookDeliver) and wantedFoods or {}

            -- Always claim ready counter dishes first before pouring or cooking
            if next(foodWants) ~= nil then
                local counterPickup = findNextBarPickup(
                    myOwner,
                    cur,
                    myPlot,
                    {},
                    foodWants,
                    trayInfo,
                    maxCarry,
                    hrpPos,
                    kitchenRemote,
                    now
                )
                if counterPickup then
                    executePickupAction(counterPickup, myOwner, kitchenRemote, serveRemote, trayInfo, now)
                    return
                end
            end

            local cookCand = nil
            if State.AutoCook and kitchenRemote then
                local plotKitchen = getPlotKitchenInfo(myOwner, hrpPos)
                cookCand = findNextCookCandidate(myOwner, cur, plotKitchen, guests, trayInfo.counts, hrpPos, now, staffCounts)
            end

            local drinkPickup = nil
            if State.AutoBarServe and next(drinkWants) ~= nil then
                drinkPickup = findNextBarPickup(
                    myOwner,
                    cur,
                    myPlot,
                    drinkWants,
                    {},
                    trayInfo,
                    maxCarry,
                    hrpPos,
                    kitchenRemote,
                    now
                )
            end

            -- Interleave Drink pours and Food cooking by oldest waiting guestId (FIFO) so food orders never starve
            if cookCand then
                local oldestDrinkGid = drinkPickup and getOldestUnservedDrinkGuestId(guests, hrpPos, trayInfo.counts, staffCounts)
                if (not drinkPickup) or (cookCand.guestId < (oldestDrinkGid or math.huge)) then
                    if executeCookStart(cookCand, myOwner, kitchenRemote, now) then
                        return
                    end
                end
            end

            if drinkPickup then
                executePickupAction(drinkPickup, myOwner, kitchenRemote, serveRemote, trayInfo, now)
                return
            end

            if cookCand and executeCookStart(cookCand, myOwner, kitchenRemote, now) then
                return
            end
        end

        if modeDeliverable and trayInfo.total > 0 then
            BarBatchState.delivering = true
            for _, guest in ipairs(guests) do
                local gid = tostring(guest.guestId)
                if isGuestDeliverableForModes(guest)
                    and (trayInfo.counts[guest.order] or 0) > 0
                    and isActionableTarget(hrpPos, guest.pos)
                    and not isActionSkipped("deliver:" .. gid, now)
                    and not isMoveBlocked("guest:" .. gid, now) then
                    local readyAt = Cooldowns.deliver[guest.guestId] or 0
                    if now >= readyAt then
                        if not ensureWithinRange("guest:" .. gid, guest.pos, guest.standPos, now) then
                            return
                        end
                        Cooldowns.deliver[guest.guestId] = now + 0.75
                        noteActionAttempt("deliver:" .. gid, guest.order .. ":" .. tostring(trayInfo.counts[guest.order] or 0), now, 2, 5.0)
                        serveRemote:FireServer("Deliver", {
                            owner = guest.owner,
                            guest = guest.guestId,
                        })
                        return
                    end
                end
            end
            return
        end
    end

    -- 4. Start clearing dirty mugs & plates when tray has space and no pending serve batch runs
    if State.AutoClearWash and trayInfo.total < maxCarry then
        local nextSeat = inspectDirtySeats(myOwner, hrpPos, now)
        if nextSeat then
            clearDirtySeat(nextSeat, trayInfo.total, now)
            return
        end
    end

    -- 5. Auto Prep menu dishes onto serving counters when idle
    if State.AutoCookPrep and kitchenRemote and trayInfo.total == 0 and not BarBatchState.delivering and not BarBatchState.washing then
        local plotKitchen = getPlotKitchenInfo(myOwner, hrpPos)
        local prepCand = findNextPrepCandidate(myOwner, cur, plotKitchen, hrpPos, now)
        if prepCand and executeCookStart(prepCand, myOwner, kitchenRemote, now) then
            return
        end
    end
end

