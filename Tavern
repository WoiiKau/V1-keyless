-- Normalize saved single-string or multi-select table configs into a [species] = true lookup map
local function normalizeHuntFilter(raw)
    local map = {}
    if type(raw) == "table" then
        for k, v in pairs(raw) do
            if type(k) == "number" and HUNT_VALUE_RANK[v] then
                map[v] = true
            elseif v == true and HUNT_VALUE_RANK[k] then
                map[k] = true
            end
        end
        return map
    end
    if raw == "High Value" then
        for species, rank in pairs(HUNT_VALUE_RANK) do
            if rank >= 4 then
                map[species] = true
            end
        end
    elseif type(raw) == "string" and HUNT_VALUE_RANK[raw] then
        map[raw] = true
    else
        for _, species in ipairs(HUNT_SPECIES_LIST) do
            map[species] = true
        end
    end
    return map
end

local function findOwnedTool(toolName)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if char then
        local inChar = char:FindFirstChild(toolName)
        if inChar and inChar:IsA("Tool") then
            return inChar, true
        end
    end
    if backpack then
        local inBag = backpack:FindFirstChild(toolName)
        if inBag and inBag:IsA("Tool") then
            return inBag, false
        end
    end
    return nil, false
end

local function ensureToolEquipped(toolName)
    local tool, equipped = findOwnedTool(toolName)
    if not tool then return false, false end
    if equipped then return true, true end
    local _, hum = getPlayerRoot()
    if hum and hum.Health > 0 then
        pcall(function() hum:EquipTool(tool) end)
    end
    local char = LocalPlayer.Character
    local nowEquipped = char and char:FindFirstChild(toolName) ~= nil
    return true, nowEquipped
end

local function triggerPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
    if fireproximityprompt then
        local ok = pcall(fireproximityprompt, prompt)
        if ok then return true end
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.delay((prompt.HoldDuration or 0) + 0.06, function()
            if prompt and prompt.Parent then
                pcall(function() prompt:InputHoldEnd() end)
            end
        end)
    end)
    return true
end

local resolveWildlifeAimPos
do
local WildlifeCenterBoneCache = setmetatable({}, { __mode = "k" })

resolveWildlifeAimPos = function(visModel, fallbackPos, scale)
    if visModel and visModel.Parent then
        local cached = WildlifeCenterBoneCache[visModel]
        if cached == nil then
            local found = false
            for _, d in ipairs(visModel:GetDescendants()) do
                if d:IsA("Bone") and d.Name == "center" then
                    found = d
                    break
                end
            end
            WildlifeCenterBoneCache[visModel] = found
            cached = found
        end
        if cached and cached.Parent then
            return cached.TransformedWorldCFrame.Position
        end
        local _, bodyPos = getLiveWorldPartAndPos(visModel, false)
        if bodyPos then
            return bodyPos
        end
    end
    if fallbackPos then
        return fallbackPos + Vector3.new(0, 1.5 * (scale or 1), 0)
    end
    return nil
end
end

local function buildWildlifeInfo(cfg, hrpPos, nowServer)
    if not cfg or not cfg.Parent then return nil end
    local id = tonumber(cfg.Name)
    if not id then return nil end
    local state = cfg:GetAttribute("State")
    local goneAt = cfg:GetAttribute("GoneAt")
    local species = tostring(cfg:GetAttribute("Species") or "")
    local scale = tonumber(cfg:GetAttribute("Scale")) or 1
    local group = tonumber(cfg:GetAttribute("Group"))
    local fromPos = cfg:GetAttribute("From")
    local toPos = cfg:GetAttribute("To")
    local t0 = tonumber(cfg:GetAttribute("T0")) or 0
    local speed = tonumber(cfg:GetAttribute("Speed")) or 0

    local rawPos = (typeof(fromPos) == "Vector3" and fromPos) or (typeof(toPos) == "Vector3" and toPos)
    local vel = Vector3.zero
    if typeof(fromPos) == "Vector3" and typeof(toPos) == "Vector3" then
        local delta = toPos - fromPos
        local dMag = delta.Magnitude
        if dMag > 0.1 and speed > 0 then
            local rawAlpha = ((nowServer or Workspace:GetServerTimeNow()) - t0) * speed / dMag
            if rawAlpha < 1 then
                vel = delta.Unit * speed
            end
            rawPos = fromPos:Lerp(toPos, math.clamp(rawAlpha, 0, 1))
        end
    end

    local wsWildlife = Workspace:FindFirstChild("Wildlife")
    local visModel = wsWildlife and wsWildlife:FindFirstChild(species .. cfg.Name)
    local visPart = visModel and select(1, getLiveWorldPartAndPos(visModel, false)) or nil
    local pos = resolveWildlifeAimPos(visModel, rawPos, scale)
    if not pos then return nil end

    local stateStr = tostring(state or "")
    return {
        id = id,
        cfg = cfg,
        species = species,
        scale = scale,
        group = group,
        state = stateStr,
        charging = (stateStr == "Charge" or stateStr == "Strike" or stateStr == "Alert"),
        down = (stateStr == "Down"),
        gone = (goneAt ~= nil),
        pos = pos,
        vel = vel,
        visModel = visModel,
        visPart = visPart,
        dist = hrpPos and (pos - hrpPos).Magnitude or 0,
    }
end

local function findNearestBoneAndRel(model, worldPos)
    if model and model.Parent then
        local bestBone, bestDist = nil, math.huge
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Bone") then
                local dist = (d.TransformedWorldCFrame.Position - worldPos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestBone = d
                end
            end
        end
        if bestBone then
            return bestBone.Name, bestBone.TransformedWorldCFrame:ToObjectSpace(CFrame.new(worldPos))
        end
        local part = getLiveWorldPartAndPos(model, true)
        if part then
            return "root", part.CFrame:ToObjectSpace(CFrame.new(worldPos))
        end
    end
    return "root", CFrame.identity
end

local function solveBowAim(origin, targetPos, targetVel, speed)
    local aimAtFn = Hunting and Hunting.aimAt
    local vel = targetVel or Vector3.zero
    local s = speed or (Hunting and Hunting.MAX_SPEED) or 240
    local g = (Hunting and Hunting.GRAVITY) or 70

    local function solvePoint(pt)
        if aimAtFn then
            local d, t = aimAtFn(origin, pt, s)
            if d and t then return d, t end
        end
        local delta = pt - origin
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local flatMag = flat.Magnitude
        if flatMag < 1 then
            local dir = delta.Magnitude > 0.05 and delta.Unit or Vector3.new(0, 0, -1)
            return dir, math.max(0.004, delta.Magnitude / s)
        end
        local v2 = s * s
        local disc = v2 * v2 - g * (g * flatMag * flatMag + 2 * delta.Y * v2)
        if disc < 0 then return nil, nil end
        local angle = math.atan((v2 - math.sqrt(disc)) / (g * flatMag))
        local dir = flat.Unit * math.cos(angle) + Vector3.new(0, math.sin(angle), 0)
        return dir, math.max(0.004, flatMag / (s * math.cos(angle)))
    end

    local aimPt = targetPos
    local dir, t = solvePoint(aimPt)
    if dir and t and vel.Magnitude > 0.1 then
        for _ = 1, 2 do
            local leadPt = targetPos + vel * math.min(t, 1.4)
            local d2, t2 = solvePoint(leadPt)
            if d2 and t2 then
                aimPt = leadPt
                dir, t = d2, t2
            end
        end
    end
    return dir, t, aimPt
end

local function recordPendingLoot(id, pos, cfg, now)
    if not State.AutoCollectKills or not id or not pos then return end
    if now < (OutdoorsState.collectedLoot[id] or 0) then return end
    local entry = OutdoorsState.pendingLoot[id]
    if entry and entry.collected then return end
    if entry then
        entry.pos = pos
        entry.cfg = cfg or entry.cfg
        return
    end
    OutdoorsState.pendingLoot[id] = {
        cfg = cfg,
        pos = pos,
        expiresAt = now + 3.4,
        collected = false,
    }
end

local function getTrackedHuntTarget(targetId, isPumpkin, hrpPos)
    if isPumpkin then
        if not State.HuntPumpkin then return nil end
        local pCfg = ReplicatedStorage:FindFirstChild("Pumpkin")
        local pState = pCfg and pCfg:GetAttribute("State")
        if pCfg and pCfg:GetAttribute("Active") == true and pState ~= "Idle" and pState ~= "Dead" then
            local gp = Workspace:FindFirstChild("GiantPumpkin")
            if gp then
                local part, pos = getLiveWorldPartAndPos(gp, true)
                if pos then
                    return {
                        id = 0,
                        pumpkin = true,
                        species = "GiantPumpkin",
                        pos = pos + Vector3.new(0, 4, 0),
                        vel = Vector3.zero,
                        visModel = gp,
                        visPart = part,
                        dist = hrpPos and (pos - hrpPos).Magnitude or 0,
                    }
                end
            end
        end
        return nil
    end

    local wf = ReplicatedStorage:FindFirstChild("Wildlife")
    local cfg = wf and targetId and wf:FindFirstChild(tostring(targetId))
    local info = buildWildlifeInfo(cfg, hrpPos, Workspace:GetServerTimeNow())
    if not info or info.down or info.gone then return nil end
    local filter = type(State.HuntFilter) == "table" and State.HuntFilter or normalizeHuntFilter(State.HuntFilter)
    if not filter[info.species] then return nil end
    info.pumpkin = false
    return info
end

local function scanHuntingContext(hrpPos, now)
    local ctx = {
        candidates = {},
        threats = {},
        hasGroupAlive = false,
        hasImmediateThreat = false,
    }
    local wf = ReplicatedStorage:FindFirstChild("Wildlife")
    if not wf then return ctx end

    local filter = type(State.HuntFilter) == "table" and State.HuntFilter or normalizeHuntFilter(State.HuntFilter)
    local hasFilter = next(filter) ~= nil
    local maxShootRange = ((Hunting and Hunting.MAX_RANGE) or 320) - 18
    local nowServer = Workspace:GetServerTimeNow()
    local activeGroup = OutdoorsState.huntGroupId

    for _, cfg in ipairs(wf:GetChildren()) do
        local info = buildWildlifeInfo(cfg, hrpPos, nowServer)
        if info then
            local sameGroup = (activeGroup ~= nil and info.group == activeGroup)
            if info.down and not info.gone then
                -- Hold freshly downed engaged animals briefly until their HuntPrompt settles
                if sameGroup or info.id == OutdoorsState.lockedTargetId or (OutdoorsState.animalHits[info.id] or 0) > 0 then
                    recordPendingLoot(info.id, info.pos, cfg, now)
                end
            elseif not info.down and not info.gone and hasFilter and filter[info.species] == true then
                if sameGroup then
                    ctx.hasGroupAlive = true
                end
                if (info.charging and info.dist <= 65) or (sameGroup and info.dist <= 105) then
                    ctx.hasImmediateThreat = true
                end
                if info.dist <= 52 and (info.charging or ((info.species == "Wolf" or info.species == "Bear") and (sameGroup or info.id == OutdoorsState.lockedTargetId))) then
                    table.insert(ctx.threats, info)
                end
                if State.HuntWalkToTarget or info.dist <= maxShootRange then
                    info.pumpkin = false
                    table.insert(ctx.candidates, info)
                end
            end
        end
    end

    if activeGroup ~= nil and not ctx.hasGroupAlive then
        OutdoorsState.huntGroupId = nil
    end
    return ctx
end

local function getHuntTargetCandidate(hrpPos, now, ctxArg)
    local checkNow = now or os.clock()
    local ctx = ctxArg or scanHuntingContext(hrpPos, checkNow)
    local hasBowNow = findOwnedTool((Hunting and Hunting.TOOL) or "Hunting Bow") ~= nil
    local playerInWaterZone = (not hasBowNow) and FishingConfig and type(FishingConfig.distanceToWater) == "function"
        and FishingConfig.distanceToWater(hrpPos.X, hrpPos.Z) <= ((FishingConfig.REACH or 30) + 6)
    local activeGroup = OutdoorsState.huntGroupId

    local best, bestScore = nil, math.huge
    local bestFallback, bestFallbackScore = nil, math.huge
    local hasUrgentPredator = ctx.hasGroupAlive or ctx.hasImmediateThreat

    for _, info in ipairs(ctx.candidates) do
        local dist = info.dist
        local valueBonus = (HUNT_VALUE_RANK[info.species] or 1) * 6
        local waterPenalty = 0
        if playerInWaterZone and FishingConfig.distanceToWater(info.pos.X, info.pos.Z) <= ((FishingConfig.REACH or 30) + 6) then
            waterPenalty = 250
        end
        local packBonus = (activeGroup ~= nil and info.group == activeGroup) and 500 or 0
        local chargeBonus = (info.charging and dist <= 85) and (350 - dist * 1.5) or 0
        local lockBonus = (info.id == OutdoorsState.lockedTargetId) and 120 or 0
        local hitBonus = math.min(OutdoorsState.animalHits[info.id] or 0, 3) * 90
        local score = dist + waterPenalty - valueBonus - packBonus - chargeBonus - lockBonus - hitBonus

        if checkNow < (Cooldowns.huntSkip[info.id] or 0) then
            if score < bestFallbackScore then
                bestFallbackScore = score
                bestFallback = info
            end
        elseif score < bestScore then
            bestScore = score
            best = info
        end
    end

    if State.HuntPumpkin and not hasUrgentPredator then
        local pumpkin = getTrackedHuntTarget(0, true, hrpPos)
        local maxShootRange = ((Hunting and Hunting.MAX_RANGE) or 320) - 18
        if pumpkin and (State.HuntWalkToTarget or pumpkin.dist <= maxShootRange) then
            return pumpkin
        end
    end

    return best or bestFallback
end

local function tryCollectPromptItem(item, prompt, now)
    if not item or not item.Parent or not prompt or not prompt.Enabled then return false end
    local banUntil = Cooldowns.huntCollectBan[item] or 0
    if now < banUntil then return false end

    local firstAt = Cooldowns.huntCollectFirst[item]
    if not firstAt then
        Cooldowns.huntCollectFirst[item] = now
        firstAt = now
    elseif now - firstAt > 5.2 then
        Cooldowns.huntCollectBan[item] = now + 20
        Cooldowns.huntCollectFirst[item] = nil
        local pendingId = tonumber(item.Name)
        if pendingId and OutdoorsState.pendingLoot[pendingId] then
            OutdoorsState.pendingLoot[pendingId].collected = true
        end
        return false
    end

    if now >= (Cooldowns.huntCollect[item] or 0) then
        Cooldowns.huntCollect[item] = now + 0.42
        triggerPrompt(prompt)
    end
    return true
end

local function tryPassiveCollectNearby(now, hrpPos)
    local hpFolder = Workspace:FindFirstChild("HuntPrompts")
    if not hpFolder then return end
    local myId = LocalPlayer.UserId
    local collectReach = ((Hunting and Hunting.COLLECT_RANGE) or 12) - 1.2
    for _, item in ipairs(hpFolder:GetChildren()) do
        local prompt = item:FindFirstChildOfClass("ProximityPrompt")
        if prompt and prompt.Enabled then
            local shooter = item:GetAttribute("Shooter")
            if shooter == myId or shooter == nil or shooter == 0 then
                local pos = item:IsA("BasePart") and item.Position or item:GetPivot().Position
                if (pos - hrpPos).Magnitude <= collectReach then
                    tryCollectPromptItem(item, prompt, now)
                end
            end
        end
    end
end

local function stepCollectKills(now, hrpPos, hum, hrp, huntCtx)
    local hpFolder = Workspace:FindFirstChild("HuntPrompts")
    local myId = LocalPlayer.UserId
    local collectReach = ((Hunting and Hunting.COLLECT_RANGE) or 12) - 2.0
    local maxLootDist = State.HuntWalkToTarget and (State.AutoHunt and 240 or 55) or collectReach

    -- Keep kiting/clearing nearby charging packmates before walking onto distant corpses
    if State.AutoHunt and huntCtx and huntCtx.hasImmediateThreat then
        tryPassiveCollectNearby(now, hrpPos)
        return false
    end

    local bestPart, bestPrompt, bestDist = nil, nil, math.huge
    if hpFolder then
        for _, item in ipairs(hpFolder:GetChildren()) do
            local pendingId = tonumber(item.Name)
            if pendingId and OutdoorsState.pendingLoot[pendingId] then
                local pl = OutdoorsState.pendingLoot[pendingId]
                pl.sawPrompt = true
                pl.expiresAt = math.max(pl.expiresAt, now + 0.8)
            end
            local prompt = item:FindFirstChildOfClass("ProximityPrompt")
            if prompt and prompt.Enabled and now >= (Cooldowns.huntCollectBan[item] or 0) then
                local shooter = item:GetAttribute("Shooter")
                if shooter == myId or shooter == nil or shooter == 0 then
                    local pos = item:IsA("BasePart") and item.Position or item:GetPivot().Position
                    local d = (pos - hrpPos).Magnitude
                    if d <= maxLootDist and d < bestDist then
                        bestDist = d
                        bestPart = item
                        bestPrompt = prompt
                    end
                end
            end
        end
    end

    if bestPart then
        local partPos = bestPart:IsA("BasePart") and bestPart.Position or bestPart:GetPivot().Position
        if not ensureWithinRange("collect_kill:" .. bestPart.Name, partPos, partPos, now, collectReach, State.HuntWalkToTarget) then
            return true
        end
        return tryCollectPromptItem(bestPart, bestPrompt, now)
    end

    -- Wait briefly for freshly downed kills finishing fallStop before wandering off
    local nearestPendingId, nearestPendingPos, nearestPendingDist = nil, nil, math.huge
    for id, entry in pairs(OutdoorsState.pendingLoot) do
        local gone = entry.cfg and entry.cfg.Parent and entry.cfg:GetAttribute("GoneAt") ~= nil
        local promptObj = hpFolder and hpFolder:FindFirstChild(tostring(id))
        local vanishedAfterSeen = entry.sawPrompt and (promptObj == nil)
        local promptBanned = promptObj and now < (Cooldowns.huntCollectBan[promptObj] or 0)
        if entry.collected or gone or vanishedAfterSeen or promptBanned or now > entry.expiresAt then
            if vanishedAfterSeen then
                OutdoorsState.collectedLoot[id] = now + 20
                OutdoorsState.animalHits[id] = nil
            end
            OutdoorsState.pendingLoot[id] = nil
        elseif entry.pos then
            if promptObj then
                entry.pos = promptObj:IsA("BasePart") and promptObj.Position or promptObj:GetPivot().Position
            end
            local d = (entry.pos - hrpPos).Magnitude
            if d <= maxLootDist and d < nearestPendingDist then
                nearestPendingDist = d
                nearestPendingId = id
                nearestPendingPos = entry.pos
            end
        end
    end

    if nearestPendingPos then
        if ensureWithinRange("wait_kill:" .. tostring(nearestPendingId), nearestPendingPos, nearestPendingPos, now, collectReach, State.HuntWalkToTarget) then
            if ActivePath.walking then
                stopAutoWalk(hum, hrp)
            end
        end
        return true
    end

    return false
end

local function getFishingBankAnchor(hrpPos)
    local spotPref = State.FishSpot or "Nearest Water"
    local candidates = {}

    if ReplicatedStorage:GetAttribute("Season") == "Winter" then
        local iceHoles = Workspace:FindFirstChild("IceHoles")
        if iceHoles then
            local bestHole, bestD = nil, math.huge
            for _, m in ipairs(iceHoles:GetChildren()) do
                local w = m:FindFirstChild("Water")
                if w and w:IsA("BasePart") then
                    local d = horizontalDist(hrpPos, w.Position)
                    if d < bestD then
                        bestD = d
                        bestHole = w.Position
                    end
                end
            end
            if bestHole then
                local outDir = Vector3.new(hrpPos.X - bestHole.X, 0, hrpPos.Z - bestHole.Z)
                outDir = outDir.Magnitude > 0.1 and outDir.Unit or Vector3.new(1, 0, 0)
                local bankXZ = bestHole + outDir * 10.0
                local gy = resolveWorldGroundY(bankXZ, 4, true, false, false)
                table.insert(candidates, Vector3.new(bankXZ.X, gy, bankXZ.Z))
            end
        end
    end

    if (spotPref == "Nearest Water" or spotPref == "Town Pond") and TownLayout and TownLayout.Pond and #TownLayout.Pond >= 3 then
        local cx, cz = 0, 0
        for _, v in ipairs(TownLayout.Pond) do
            cx = cx + v.x
            cz = cz + v.z
        end
        cx = cx / #TownLayout.Pond
        cz = cz / #TownLayout.Pond

        local bestVert, bestD = nil, math.huge
        for _, v in ipairs(TownLayout.Pond) do
            local d = math.hypot(v.x - hrpPos.X, v.z - hrpPos.Z)
            if d < bestD then
                bestD = d
                bestVert = v
            end
        end
        if bestVert then
            local outDir = Vector3.new(bestVert.x - cx, 0, bestVert.z - cz)
            outDir = outDir.Magnitude > 0.1 and outDir.Unit or Vector3.new(1, 0, 0)
            local bankXZ = Vector3.new(bestVert.x, 4, bestVert.z) + outDir * 7.5
            local gy = resolveWorldGroundY(bankXZ, 4, true, false, false)
            table.insert(candidates, Vector3.new(bankXZ.X, gy, bankXZ.Z))
        end
    end

    if spotPref == "Nearest Water" or spotPref == "River Bridge" then
        if spotPref == "River Bridge" then
            table.insert(candidates, Vector3.new(165, 4.5, -24))
        elseif TownLayout and TownLayout.River and #TownLayout.River >= 2 then
            local halfW = (TownLayout.RiverWidth or 30) * 0.5 + 8.0
            local bestBank, bestD = Vector3.new(165, 4.5, -24), math.huge
            for i = 1, #TownLayout.River - 1 do
                local a = TownLayout.River[i]
                local b = TownLayout.River[i + 1]
                local dx, dz = b.x - a.x, b.z - a.z
                local lenSq = dx * dx + dz * dz
                local t = lenSq > 0 and math.clamp(((hrpPos.X - a.x) * dx + (hrpPos.Z - a.z) * dz) / lenSq, 0, 1) or 0
                local px, pz = a.x + dx * t, a.z + dz * t
                local nx, nz = hrpPos.X - px, hrpPos.Z - pz
                local nMag = math.hypot(nx, nz)
                if nMag < 0.1 then
                    nx, nz, nMag = -dz, dx, math.max(0.1, math.hypot(dx, dz))
                end
                local bankXZ = Vector3.new(px + (nx / nMag) * halfW, 5, pz + (nz / nMag) * halfW)
                local d = horizontalDist(hrpPos, bankXZ)
                if d < bestD then
                    bestD = d
                    bestBank = bankXZ
                end
            end
            local gy = resolveWorldGroundY(bestBank, 5, true, false, false)
            table.insert(candidates, Vector3.new(bestBank.X, gy, bestBank.Z))
        end
    end

    local chosen, chosenD = nil, math.huge
    for _, pt in ipairs(candidates) do
        local d = horizontalDist(hrpPos, pt)
        if d < chosenD then
            chosenD = d
            chosen = pt
        end
    end
    return chosen or Vector3.new(165, 4.5, -24)
end

local function findWaterCastPoint(hrp)
    if not hrp then return nil end
    local hrpPos = hrp.Position

    if ReplicatedStorage:GetAttribute("Season") == "Winter" then
        local iceHoles = Workspace:FindFirstChild("IceHoles")
        if iceHoles then
            local bestWater, bestD = nil, (FishingConfig and FishingConfig.CAST_RANGE or 60) - 6
            for _, m in ipairs(iceHoles:GetChildren()) do
                local w = m:FindFirstChild("Water")
                if w and w:IsA("BasePart") then
                    local d = horizontalDist(hrpPos, w.Position)
                    if d <= bestD then
                        bestD = d
                        bestWater = Vector3.new(w.Position.X, w.Position.Y + 0.1, w.Position.Z)
                    end
                end
            end
            if bestWater then return bestWater end
        end
    end

    if FishingConfig and type(FishingConfig.distanceToWater) == "function" then
        local maxBankDist = (FishingConfig.REACH or 30) - (State.FishWalkToWater and 8 or 1)
        if FishingConfig.distanceToWater(hrpPos.X, hrpPos.Z) > maxBankDist then
            return nil
        end
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { Workspace.Terrain }
    params.IgnoreWater = false

    local look = hrp.CFrame.LookVector
    local baseAngle = math.atan2(look.Z, look.X)
    local radii = { 12, 18, 24, 30, 38, 46 }
    local bestPos, bestDist = nil, math.huge

    for _, r in ipairs(radii) do
        for step = 0, 15 do
            local ang = baseAngle + step * (math.pi / 8)
            local p = hrpPos + Vector3.new(math.cos(ang) * r, 22, math.sin(ang) * r)
            local hit = Workspace:Raycast(p, Vector3.new(0, -65, 0), params)
            if hit and hit.Material == Enum.Material.Water then
                local d = horizontalDist(hrpPos, hit.Position)
                if d >= 6 and d < bestDist then
                    bestDist = d
                    bestPos = hit.Position
                    if step == 0 and r <= 24 then
                        return bestPos
                    end
                end
            end
        end
    end
    return bestPos
end

