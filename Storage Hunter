            local conn = val.Changed:Connect(function(cf) 
                hrp.CFrame = cf
            end)
            
            local tw2 = TweenService:Create(val, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Value = safeCF})
            tw2.Completed:Connect(function()
                conn:Disconnect()
                val:Destroy()
