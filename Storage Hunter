                    nwVal = rawAttr
                    return
                end
                local raw = tostring(nwObj.Value or ""):gsub("%$", ""):gsub(",", ""):upper()
                local num = tonumber(raw:match("[%d%.]+")) or 0
                if raw:find("B") then
                    nwVal = num * 1000000000
                elseif raw:find("M") then
                    nwVal = num * 1000000
                elseif raw:find("K") then
                    nwVal = num * 1000
                else
