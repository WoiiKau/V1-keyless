                    abLog("Priority Auction starting! Pausing mining to bid.", C.accent)
                    stopMining()
                    break
                end

                task.wait(0.5)
            end

            stopMining()
            if not isContinuous then
                abLog("[Mine] Mining cycle complete.", C.green)
