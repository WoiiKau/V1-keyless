    elseif lowerMsg:find("cannot sell") or lowerMsg:find("can't be shelved") or lowerMsg:find("no sell value") or lowerMsg:find("%[quest%]") then
        if _G.AHLastPlacingGuid then
            _G.AHUnsellableGuids[_G.AHLastPlacingGuid] = true
