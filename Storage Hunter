                    local pct = math.round((rateMultiplier - 1) * 100)
                    rateLbl.Text = string.format("Rate: %s%d%%", pct >= 0 and "+" or "", pct)
                    rateLbl.TextColor3 = pct < 0 and C.red or C.green
                    
