                                    for _, clown in ipairs(targetFolder:GetChildren()) do
                                        if clown:IsA("Model") and clown:GetAttribute("CarnivalClown") == true
                                            and clown:GetAttribute("ClownUp") == true
                                            and clown:GetAttribute("ClownHit") ~= true
