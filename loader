if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Create sleek ScreenGui
local sg = Instance.new("ScreenGui")
sg.Name = "NexBootstrapper"
sg.ResetOnSpawn = false
local parent = CoreGui:FindFirstChild("RobloxGui") or PlayerGui
sg.Parent = parent

-- Glassmorphic Main Card
local card = Instance.new("Frame")
card.Size = UDim2.new(0, 260, 0, 160)
card.Position = UDim2.new(0.5, -130, 0.5, -80)
card.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
card.BorderSizePixel = 0
card.ClipsDescendants = true
card.Parent = sg

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = card

local stroke = Instance.new("UIStroke")
stroke.Thickness = 1.5
stroke.Color = Color3.fromRGB(0, 170, 255)
stroke.Parent = card

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Position = UDim2.new(0, 0, 0, 15)
title.BackgroundTransparency = 1
title.Text = "NEX HUB"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = card

-- Status Text
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 20)
status.Position = UDim2.new(0, 10, 0, 50)
status.BackgroundTransparency = 1
status.Text = "Initializing..."
status.TextColor3 = Color3.fromRGB(200, 200, 200)
status.Font = Enum.Font.GothamSemibold
status.TextSize = 11
status.Parent = card

-- Progress Bar Background
local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(1, -40, 0, 6)
barBg.Position = UDim2.new(0, 20, 0, 85)
barBg.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
barBg.BorderSizePixel = 0
barBg.Parent = card

local barCorner = Instance.new("UICorner")
barCorner.CornerRadius = UDim.new(0, 3)
barCorner.Parent = barBg

-- Progress Bar Fill
local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
barFill.BorderSizePixel = 0
barFill.Parent = barBg

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 3)
fillCorner.Parent = barFill

local fillGlow = Instance.new("UIStroke")
fillGlow.Thickness = 1.2
fillGlow.Color = Color3.fromRGB(0, 170, 255)
fillGlow.Parent = barFill

-- Welcome User Text
local welcome = Instance.new("TextLabel")
welcome.Size = UDim2.new(1, 0, 0, 20)
welcome.Position = UDim2.new(0, 0, 0, 115)
welcome.BackgroundTransparency = 1
welcome.Text = "Welcome, " .. LocalPlayer.DisplayName .. "!"
welcome.TextColor3 = Color3.fromRGB(0, 170, 255)
welcome.Font = Enum.Font.GothamBold
welcome.TextSize = 10
welcome.TextTransparency = 1
welcome.Parent = card

-- Loader sequence
task.spawn(function()
    local function setProgress(pct, statusText, duration)
        status.Text = statusText
        TweenService:Create(barFill, TweenInfo.new(duration or 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(pct, 0, 1, 0)
        }):Play()
        task.wait(duration or 0.5)
    end
    
    setProgress(0.1, "Initializing Nex HUB v13.0...", 0.4)
    setProgress(0.3, "Analyzing executor environment...", 0.6)
    
    local identify = identifyexecutor or (syn and syn.identifyexecutor)
    local execName = "Unknown"
    pcall(function() execName = string.lower(tostring(identify())) end)
    
    local isLowLevel = false
    local lowLevelList = {"xeno", "solara", "celery", "incognito", "lunar", "zorara"}
    for _, name in ipairs(lowLevelList) do
        if execName:find(name) then
            isLowLevel = true
            break
        end
    end
    
    if isLowLevel then
        setProgress(0.6, "Applying environment protections...", 0.8)
        setProgress(0.8, "Routing to safe Low UNC build...", 0.5)
    else
        setProgress(0.6, "Optimizing modules cache...", 0.5)
        setProgress(0.8, "Routing to premium High UNC build...", 0.5)
    end
    
    -- Fade in welcome message
    TweenService:Create(welcome, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0
    }):Play()
    setProgress(1.0, "Ready!", 0.5)
    
    -- Smooth card shrink exit
    TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    }):Play()
    task.wait(0.4)
    sg:Destroy()
    
    -- Load target script directly from GitHub (Cache-busted)
    local success, err = pcall(function()
        local cacheBust = "?t=" .. tostring(os.time())
        if isLowLevel then
            loadstring(game:HttpGet("https://raw.githubusercontent.com/WoiiKau/V1-keyless/refs/heads/main/Storage%20%20Hunter%20Xeno" .. cacheBust))()
        else
            loadstring(game:HttpGet("https://raw.githubusercontent.com/WoiiKau/V1-keyless/refs/heads/main/Storage%20Hunter" .. cacheBust))()
        end
    end)
    
    if not success then
        warn("[Nex HUB] Failed to load main script: " .. tostring(err))
    end
end)
