    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert then
        State.GuiVisible = not State.GuiVisible
        mainFrame.Visible = State.GuiVisible
    end
end)

-- ==============================================================================
-- CORE BRUTEFORCE MINING ENGINE
-- ==============================================================================
local farmThread = nil

local function stopFarming()
    State.Active = false
    State.CurrentStatus = "Idle"
    pcall(function()
        local mines = workspace:FindFirstChild("Areas") and workspace.Areas:FindFirstChild("The Mines")
        local rn = mines and mines:FindFirstChild("RockNodes")
        if rn then
            for _, m in ipairs(rn:GetChildren()) do
                local p = m:FindFirstChildWhichIsA("ProximityPrompt", true)
                if p and p.ActionText == "Stop Mining" then
                    safeFirePrompt(p)
                    task.wait(0.2)
                    break
                end
            end
        end
    end)
    updateUI()
end

local function runMiningSession()
    while State.Active do
        -- 1. Unsit
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum and hum.Sit then
            hum.Sit = false
            task.wait(0.25)
        end

        -- 2. Equip Best Pickaxe
        local pickaxe = equipBestPickaxe()
        if not pickaxe or pickaxe == "None" then
            State.CurrentStatus = "⚠️ No Pickaxe Found in Bag!"
            updateUI()
            task.wait(2)
            break
        end

        -- 3. Resolve Node
        local nodeIdx = resolveTargetNode()
        local req = NODE_REQ[nodeIdx]
        local playerNW = getPlayerNW()
        if req and playerNW < req.nw then
            nodeIdx = getBestEligibleNode()
        end

        local targetPos = NODE_POS[nodeIdx]
        if not targetPos then
            State.CurrentStatus = "❌ Invalid Node Target: " .. tostring(nodeIdx)
            updateUI()
            task.wait(2)
            break
        end

        -- 4. Travel / Safe TP
        State.CurrentStatus = "⛏️ Traveling to Node " .. nodeIdx .. "..."
        updateUI()

        local standCF = CFrame.new(targetPos + Vector3.new(0, 1.2, 3.5), targetPos)
        safeTP(standCF)

        -- 5. Wait for Prompt Stream
        local prompt = nil
        local startWait = os.clock()
        while os.clock() - startWait < 4 and State.Active do
            prompt = getRockNodePrompt(nodeIdx)
            if prompt then break end
            task.wait(0.25)
        end

        if not prompt or not State.Active then
            if not prompt then
                State.CurrentStatus = "⚠️ Node " .. nodeIdx .. " prompt stream timeout"
                updateUI()
                task.wait(1)
            end
            break
        end

        safeTP(standCF)
        task.wait(0.25)

        -- 6. Start Initial Mining Action
        if prompt.ActionText == "Mine" then
            safeFirePrompt(prompt)
            task.wait(0.5)
        end

        State.CurrentStatus = "Mining Node " .. nodeIdx .. " (0%)"
        updateUI()

        -- 7. Main Mining / Bruteforce Loop
        local lastPct = 0
        local lastRewardTime = os.clock()
        local lastRerollTime = 0

        while State.Active do
            local liveCh = LocalPlayer.Character
            local liveHum = liveCh and liveCh:FindFirstChildOfClass("Humanoid")
            local liveHrp = liveCh and liveCh:FindFirstChild("HumanoidRootPart")
            if not liveHum or liveHum.Health <= 0 or not liveHrp then
                task.wait(1)
                break
            end

            -- Tether check
            if (liveHrp.Position - targetPos).Magnitude > 7 then
                safeTP(standCF)
                task.wait(0.2)
            end

            prompt = getRockNodePrompt(nodeIdx)
            local action = prompt and prompt.ActionText

            -- Inspect MiningHud
            local hud = LocalPlayer.PlayerGui:FindFirstChild("MiningHud")
            local panel = hud and hud:FindFirstChild("MiningPanel")
            local fill = panel and panel:FindFirstChild("Bar") and panel.Bar:FindFirstChild("Fill")
            local hint = panel and panel:FindFirstChild("Hint") and panel.Hint.Text or ""
            local progress = fill and fill.Size.X.Scale or 0
            local pct = math.floor(math.clamp(progress, 0, 1) * 100)

            -- ==========================================================
            -- 💥 THE BRUTEFORCE BYPASS (Pat's exact method):
            -- "you need to cancel mine then continue mine till you get ruby"
            -- When game rejects non-matching roll (inventory full):
            -- 1. Cancel mine ("Stop Mining")
            -- 2. Immediately re-fire ("Mine")
            -- 3. Repeat until roll hits a stackable gem in your bag!
            -- ==========================================================
            local lowerHint = hint:lower()
            local isFullHint = lowerHint:find("full") or lowerHint:find("free slot") or lowerHint:find("space") or lowerHint:find("capacity")

            if isFullHint and (os.clock() - lastRerollTime > 0.8) then
                lastRerollTime = os.clock()
                State.RerollCount = State.RerollCount + 1
                State.CurrentStatus = string.format("Re-rolling (%d)...", State.RerollCount)
                updateUI()

                -- Step 1: If currently mining ("Stop Mining"), cancel the mine!
                prompt = getRockNodePrompt(nodeIdx)
                if prompt and prompt.ActionText == "Stop Mining" then
                    safeFirePrompt(prompt)
                    task.wait(0.25)
                end

                -- Step 2: Brief yield for prompt to switch back to "Mine"
                task.wait(0.15)

                -- Step 3: Continue mine (fire "Mine" prompt)
                prompt = getRockNodePrompt(nodeIdx)
                if prompt and prompt.ActionText == "Mine" then
                    safeFirePrompt(prompt)
                    task.wait(0.35)
                end

                lastPct = 0
            end

            -- Update Mining Progress (only when actively mining normally)
            if not isFullHint and pct > 0 then
                State.CurrentStatus = string.format("Mining Node %d (%d%%)", nodeIdx, pct)
                updateUI()
            end

            -- Reward Detection: Bar successfully reset from high % to low % with NO full inventory rejection
            if lastPct >= 80 and pct < 20 and (os.clock() - lastRewardTime > 2) and not isFullHint then
                lastRewardTime = os.clock()
                State.SuccessCount = State.SuccessCount + 1
                State.CurrentStatus = "Gem stored!"
                updateUI()
                refreshGemDisplay()

                -- Brief pause and begin next mining cycle
                task.wait(0.4)
                prompt = getRockNodePrompt(nodeIdx)
                if prompt and prompt.ActionText == "Mine" then
                    safeFirePrompt(prompt)
                    task.wait(0.4)
                end
            end
            lastPct = pct

            -- Idle prompt trigger (if standing at node and not mining)
            if action == "Mine" and (os.clock() - lastRewardTime > 2.5) and (os.clock() - lastRerollTime > 1.2) and pct == 0 then
                safeFirePrompt(prompt)
                task.wait(0.4)
            end

            task.wait(0.25)
        end

        task.wait(0.5)
    end

    stopFarming()
end

toggleBtn.MouseButton1Click:Connect(function()
    if State.Active then
        stopFarming()
    else
        State.Active = true
        updateUI()
        if farmThread then
            task.cancel(farmThread)
        end
        farmThread = task.spawn(runMiningSession)
    end
end)

-- Global Cleanup Routine
_G.SH_GemBruteforce_Cleanup = function()
    State.Active = false
    if farmThread then
        pcall(task.cancel, farmThread)
    end
    if afkConn then
        pcall(function() afkConn:Disconnect() end)
    end
    if inputConn then
        pcall(function() inputConn:Disconnect() end)
    end
    if screenGui and screenGui.Parent then
        pcall(function() screenGui:Destroy() end)
    end
end

