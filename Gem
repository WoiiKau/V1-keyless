local function refreshGemDisplay()
    local invCount = LocalPlayer:GetAttribute("InventoryCount")
    local invCap = LocalPlayer:GetAttribute("InventoryCap")
    local inv = getInventory()
    
    if not invCount and inv then
        local count = 0
        for _ in pairs(inv) do count = count + 1 end
        invCount = count
    end
    invCount = invCount or 0
    invCap = invCap or 20

    if invCount >= invCap then
        bagCapLbl.Text = string.format("Bag: %d/%d (Full)", invCount, invCap)
        bagCapLbl.TextColor3 = Color3.fromRGB(0, 255, 170)
    else
        bagCapLbl.Text = string.format("Bag: %d/%d (Fill %d more slot%s to bruteforce)", invCount, invCap, invCap - invCount, (invCap - invCount) == 1 and "" or "s")
        bagCapLbl.TextColor3 = Color3.fromRGB(255, 180, 60)
    end

    local detected = {}
    for _, id in ipairs(JEWEL_IDS) do
        local n = countGem(id)
        if n > 0 then
            table.insert(detected, string.format("%s (%d)", JEWEL_NAMES[id] or id, n))
        end
    end
    if #detected > 0 then
        gemListLbl.Text = "Targets: " .. table.concat(detected, ", ")
        gemListLbl.TextColor3 = Color3.fromRGB(100, 255, 180)
    else
        gemListLbl.Text = "No gems in bag (put target gem in bag)"
        gemListLbl.TextColor3 = Color3.fromRGB(255, 150, 100)
    end
end
